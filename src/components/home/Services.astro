---
import { Picture } from 'astro:assets';
import { t, type Locale, localePath } from '../../lib/i18n';
import { SERVICES } from '../../lib/services';

interface Props {
  locale: Locale;
  /** Якір для посилань із футера. */
  id?: string;
}
const { locale, id } = Astro.props;

/**
 * На головній — лише головні послуги.
 *
 * Тут раніше стояв власний масив із етапами роботи («обмір», «концепція»,
 * «креслення»). Замовниця вказала, що це не послуги, і надіслала справжній
 * перелік — тепер він у lib/services.ts, спільний із /services.
 *
 * Консультацію вона просила не виносити в головні картки, тож фільтр за
 * featured, а не зріз за кількістю: рішення лежить у даних, а не тут.
 */
const featured = SERVICES.filter((s) => s.featured);
---

<section class="services section" id={id}>
  <div class="container">
    <header class="services__head" data-reveal>
      <p class="t-eyebrow">{t(locale, 'services.eyebrow')}</p>
      <h2 class="t-h2">{t(locale, 'services.title')}</h2>
    </header>

    <ol class="services__list">
      {
        featured.map((s, i) => (
          <li class="service" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <span class="service__plate plate">
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={s.image}
                alt={s.title}
                widths={[400, 800, 1200]}
                sizes="(max-width: 700px) 92vw, 44vw"
                loading="lazy"
              />
            </span>
            <p class="t-meta service__num">{String(i + 1).padStart(3, '0')}</p>
            <h3 class="service__title">{s.title}</h3>
            <p class="service__text">{s.short}</p>
            {/*
              Ведемо на якір саме цієї послуги, а не просто на /services:
              там розкритий перелік того, що входить, і користувач
              потрапляє одразу до нього, а не шукає потрібну картку серед
              шести. aria-label потрібен, бо шість однакових «Learn more»
              поспіль у списку посилань скрінрідера нічого не розрізняють.
            */}
            <p class="service__more">
              <a
                class="link"
                href={`${localePath(locale, '/services')}#${s.slug}`}
                aria-label={`${t(locale, 'services.more')} — ${s.title}`}
              >
                {t(locale, 'services.more')}
              </a>
            </p>
          </li>
        ))
      }
    </ol>

  </div>
</section>

<style>
  .services__head {
    margin-bottom: var(--space-xl);
  }

  .services__head .t-eyebrow {
    margin-bottom: var(--space-s);
  }

  .services__list {
    /* Проміжок між колонками — змінною, бо його ж рахує правило нижче. */
    --col-gap: clamp(1.5rem, 4vw, 4rem);

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4.5rem) var(--col-gap);
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: service;
  }

  /*
    Непарна остання картка стає по центру.

    Головних послуг п'ять, а колонок дві — п'ята лишалася сама в лівій
    комірці, і поруч зяяла порожня. Картка розтягується на обидві
    колонки, але тримає ширину рівно однієї, тож у ряду з чотирьох
    сусідів нічого не змінюється.

    Селектор сам вимикається, якщо послуг стане парна кількість:
    :nth-child(odd) тоді не збігається.
  */
  .services__list > li:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    justify-self: center;
    width: calc((100% - var(--col-gap)) / 2);
  }

  .service__plate {
    display: block;
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-m);
  }

  .service__plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease);
  }

  .service:hover .service__plate :global(img) {
    transform: scale(1.02);
  }

  .service__num {
    color: var(--accent-line);
  }

  .service__title {
    margin-block: var(--space-xs) var(--space-s);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
  }

  .service__text {
    color: var(--fg-muted);
    max-width: 44ch;
  }

  .service__more {
    margin-top: var(--space-m);
  }

  @media (max-width: 700px) {
    .services__list {
      grid-template-columns: 1fr;
    }

    /*
      На одній колонці центрувати нічого — і головне, ширину треба
      скинути: calc((100% - gap) / 2) зробив би останню картку вдвічі
      вужчою за решту.
    */
    .services__list > li:last-child:nth-child(odd) {
      width: auto;
    }
  }
</style>
