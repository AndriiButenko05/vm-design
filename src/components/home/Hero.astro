---
import { Picture } from 'astro:assets';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  images: ImageMetadata[];
  id?: string;
  eager?: boolean;
}

const { locale, images, id, eager = false } = Astro.props;
---

<section class="hero on-ink-deep" id={id}>
  {/*
    Фон гортається сам: кадри плавно змінюються кожні 5 секунд, керування
    немає. Перший кадр вантажиться одразу; решта лежать у <template> і
    з'являються лише після завантаження сторінки, щоб не забирати канал
    у першого екрана.
  */}
  <div class="hero__bg" aria-hidden="true" data-hero-slides>
    {
      images.map((image, i) => (
        <div class:list={['hero__slide', i === 0 && 'is-active']} data-hero-slide>
          {i === 0 ? (
            <Picture
              src={image}
              formats={['avif']}
              fallbackFormat="webp"
              alt=""
              widths={[900, 1400, 2000]}
              sizes="100vw"
              loading={eager ? 'eager' : 'lazy'}
              fetchpriority={eager ? 'high' : 'auto'}
            />
          ) : (
            <template data-hero-later>
              <Picture
                src={image}
                formats={['avif']}
                fallbackFormat="webp"
                alt=""
                widths={[900, 1400, 2000]}
                sizes="100vw"
                loading="eager"
                fetchpriority="low"
              />
            </template>
          )}
        </div>
      ))
    }
  </div>

  <div class="container hero__inner">
    <h1 class="t-display hero__slogan">
      <span>{t(locale, 'hero.line1')}</span>
      <span>{t(locale, 'hero.line2')}</span>
      <span>{t(locale, 'hero.line3')}</span>
    </h1>
    <p class="hero__lead t-lead">{t(locale, 'hero.lead')}</p>
    <p class="hero__role t-meta">{t(locale, 'hero.role')}</p>
    <p class="hero__places">{t(locale, 'hero.places')}</p>
  </div>

  <a class="hero__scroll" href="#studio" aria-label={t(locale, 'hero.scroll')}>
    <svg viewBox="0 0 16 56" aria-hidden="true" focusable="false">
      <path d="M8 0 V54 M1 47 L8 54 L15 47" />
    </svg>
  </a>
</section>

<script>
  const INTERVAL = 5000;

  for (const root of document.querySelectorAll<HTMLElement>('[data-hero-slides]')) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (slides.length < 2 || still) continue;

    const reveal = () => {
      for (const tpl of root.querySelectorAll<HTMLTemplateElement>('template[data-hero-later]')) {
        tpl.replaceWith(tpl.content.cloneNode(true));
      }
    };
    // Трохи після load і коли браузер вільний — перша зміна кадру все одно лише за 5 с.
    const later = () =>
      setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(reveal, { timeout: 2000 }) : reveal()), 1500);
    if (document.readyState === 'complete') later();
    else addEventListener('load', later, { once: true });

    let current = 0;
    const ready = (el: HTMLElement) => {
      const img = el.querySelector('img');
      return !img || (img.complete && img.naturalWidth > 0);
    };

    setInterval(() => {
      if (document.hidden) return;
      const next = (current + 1) % slides.length;
      if (!ready(slides[next])) return;
      slides[current].classList.remove('is-active');
      slides[next].classList.add('is-active');
      current = next;
    }, INTERVAL);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 8rem 5rem;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.6s var(--ease);
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  .hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgb(25 24 23 / 0.7) 0%,
        rgb(25 24 23 / 0.56) 38%,
        rgb(25 24 23 / 0.24) 72%,
        rgb(25 24 23 / 0.16) 100%
      ),
      linear-gradient(
        to bottom,
        rgb(25 24 23 / 0.35) 0%,
        rgb(25 24 23 / 0.06) 32%,
        rgb(25 24 23 / 0.06) 62%,
        rgb(25 24 23 / 0.4) 100%
      );
  }

  .hero__inner {
    max-width: min(var(--container), 68rem);
  }

  /*
    Кожна фраза — один рядок. Найдовша («Your character.») займає ~8.9
    кегля завширшки, тож кегль додатково обмежено шириною контейнера з
    запасом (÷ 9.2): на вузькому екрані літери меншають, а не переносяться.
  */
  .hero__slogan {
    font-family: var(--font-hero);
    font-size: min(clamp(2.5rem, 6.2vw, 6.25rem), calc((min(100vw, 68rem) - 2 * var(--gutter)) / 9.2));
  }

  .hero__slogan span {
    display: block;
    white-space: nowrap;
  }

  .hero__slogan span:last-child {
    color: var(--accent-inv);
  }

  .hero__lead {
    margin-top: var(--space-l);
    max-width: 34ch;
  }

  .hero__role {
    margin-top: var(--space-xl);
  }

  .hero__places {
    margin-top: var(--space-xs);
    font-size: var(--step-small);
    opacity: 0.85;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 72px;
    opacity: 0.7;
    transition: opacity var(--dur) var(--ease);
  }

  .hero__scroll:hover,
  .hero__scroll:focus-visible {
    opacity: 1;
  }

  .hero__scroll svg {
    width: 16px;
    height: 56px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    animation: hero-cue 2.4s var(--ease) infinite;
  }

  @keyframes hero-cue {
    0%,
    100% {
      transform: translateY(-4px);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll svg {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: 7.5rem 4rem;
    }

    .hero__lead {
      margin-top: var(--space-m);
    }

    .hero__role {
      margin-top: var(--space-l);
    }

    .hero__scroll {
      display: none;
    }

    .hero__bg::after {
      background:
        linear-gradient(
          to bottom,
          rgb(25 24 23 / 0.68) 0%,
          rgb(25 24 23 / 0.64) 35%,
          rgb(25 24 23 / 0.62) 70%,
          rgb(25 24 23 / 0.73) 100%
        );
    }
  }
</style>
