---
import { Picture } from 'astro:assets';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  image: ImageMetadata;
  id?: string;
  eager?: boolean;
}

const { locale, image, id, eager = false } = Astro.props;
---

<section class="hero on-ink-deep" id={id}>
  <div class="hero__bg" aria-hidden="true">
    <Picture
      src={image}
      formats={['avif']}
      fallbackFormat="webp"
      alt=""
      widths={[900, 1400, 2000]}
      sizes="100vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </div>

  <div class="container hero__inner">
    <h1 class="t-display hero__slogan">
      <span>{t(locale, 'hero.line1')}</span>
      <span>{t(locale, 'hero.line2')}</span>
      <span>{t(locale, 'hero.line3')}</span>
    </h1>
    <p class="hero__lead t-lead">{t(locale, 'hero.lead')}</p>
    <p class="hero__role t-meta">{t(locale, 'hero.role')}</p>
    <p class="hero__places">{t(locale, 'hero.places')}</p>
  </div>

  <span class="hero__scroll t-meta" aria-hidden="true">{t(locale, 'hero.scroll')}</span>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 8rem 5rem;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgb(25 24 23 / 0.7) 0%,
        rgb(25 24 23 / 0.56) 38%,
        rgb(25 24 23 / 0.24) 72%,
        rgb(25 24 23 / 0.16) 100%
      ),
      linear-gradient(
        to bottom,
        rgb(25 24 23 / 0.35) 0%,
        rgb(25 24 23 / 0.06) 32%,
        rgb(25 24 23 / 0.06) 62%,
        rgb(25 24 23 / 0.4) 100%
      );
  }

  .hero__inner {
    max-width: min(var(--container), 68rem);
  }

  .hero__slogan {
    font-family: var(--font-hero);
    font-size: clamp(2.5rem, 6.2vw, 6.25rem);
    max-width: 18ch;
  }

  .hero__slogan span {
    display: block;
  }

  .hero__slogan span:last-child {
    color: var(--accent-inv);
  }

  .hero__lead {
    margin-top: var(--space-l);
    max-width: 34ch;
  }

  .hero__role {
    margin-top: var(--space-xl);
  }

  .hero__places {
    margin-top: var(--space-xs);
    font-size: var(--step-small);
    opacity: 0.85;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    transform: translateX(-50%);
    writing-mode: vertical-rl;
    letter-spacing: 0.2em;
    opacity: 0.6;
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: 7.5rem 4rem;
    }

    .hero__lead {
      margin-top: var(--space-m);
    }

    .hero__role {
      margin-top: var(--space-l);
    }

    .hero__scroll {
      display: none;
    }

    .hero__bg::after {
      background:
        linear-gradient(
          to bottom,
          rgb(25 24 23 / 0.68) 0%,
          rgb(25 24 23 / 0.64) 35%,
          rgb(25 24 23 / 0.62) 70%,
          rgb(25 24 23 / 0.73) 100%
        );
    }
  }
</style>
