---
import { Picture } from 'astro:assets';
import { t, type Locale } from '../../lib/i18n';
import { SITE } from '../../lib/site';
import { CONTACT_BACKDROP } from '../../lib/services';

interface Props {
  locale: Locale;
  /** Якір для посилань із футера. */
  id?: string;
  /**
   * Рівень заголовка. На головній і About секція йде після h1 сторінки,
   * тож h2; на /contact вона єдина, і тоді заголовок має бути h1 —
   * інакше сторінка лишається без головного заголовка.
   */
  as?: 'h1' | 'h2';
}
const { locale, as: Heading = 'h2', id = 'contact' } = Astro.props;

/**
 * Фон — Лазурний берег із теки services: горизонтальний кадр для десктопа,
 * вертикальний для телефона. Перемикання робить <picture> через media,
 * тому це нуль JS і браузер вантажить лише потрібний файл.
 *
 * Обидва кадри яскраві (небо й море), тому поверх іде темний scrim —
 * без нього білий текст і поля форми не пройдуть за контрастом.
 */
const { wide, tall } = CONTACT_BACKDROP;

const projectTypes = ['Private residence', 'Apartment renovation', 'Commercial space', 'Exhibition stand', 'Other'];
---

<section class="contact on-ink-deep" id={id}>
  {
    wide && (
      <div class="contact__bg" aria-hidden="true">
        <Picture
          formats={['avif']}
          fallbackFormat="webp"
          src={wide}
          alt=""
          widths={[1200, 1800, 2600, 3600]}
          sizes="100vw"
          loading="lazy"
          class="contact__bg-wide"
        />
        {tall && (
          <Picture
            formats={['avif']}
            fallbackFormat="webp"
            src={tall}
            alt=""
            {/*
              Слот вертикальний, а кадр альбомний: із 3600×2025 після
              обрізки до портрета лишається ~1140 px по ширині. Саме тому
              тут великі значення — 900 px давали майже дворазове
              розтягнення на телефоні з потрійною щільністю.
            */}
            widths={[900, 1400, 2000]}
            sizes="100vw"
            loading="lazy"
            class="contact__bg-tall"
          />
        )}
      </div>
    )
  }

  <div class="container grid contact__inner">
    <div class="contact__type" data-reveal>
      <p class="t-eyebrow">{t(locale, 'contact.eyebrow')}</p>
      <Heading class="t-h2 contact__title">{t(locale, 'contact.title')}</Heading>
      <p class="t-lead">{t(locale, 'contact.lead')}</p>

      <dl class="contact__details">
        <div>
          <dt class="t-meta">Email</dt>
          <dd><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
        </div>
        <div>
          <dt class="t-meta">Instagram</dt>
          <dd>
            <a class="link" href={SITE.instagramUrl} rel="me noopener" target="_blank">
              {SITE.instagram}
            </a>
          </dd>
        </div>
        <div>
          <dt class="t-meta">Working in</dt>
          <dd>{SITE.regions.join(' · ')}</dd>
        </div>
      </dl>
    </div>

    {/*
      Звичайний POST на Formspree: без JS форма надсилається і приземляє
      на їхню сторінку. Скрипт перехоплює submit і показує статус на місці,
      бо власний «дякую»-екран у безкоштовному плані недоступний.

      Адреса дублюється в data-endpoint навмисно: form.action у DOM
      повертає адресу поточної сторінки, коли атрибута немає, тож
      відрізнити «не налаштовано» від «налаштовано» по ньому неможливо.
    */}
    <form
      class="form"
      method="POST"
      action={SITE.formAction || undefined}
      data-contact-form
      data-endpoint={SITE.formAction}
      data-reveal
    >
      {/* Тема листа в пошті Марини — інакше Formspree ставить свою. */}
      <input type="hidden" name="_subject" value="VM Design — new enquiry from the website" />
      {/* Пастка для ботів: люди цього поля не бачать і не заповнюють. */}
      <div class="form__trap" aria-hidden="true">
        <label for="company">Company</label>
        <input type="text" id="company" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form__field">
        <label for="name">{t(locale, 'contact.name')}</label>
        <input type="text" id="name" name="name" required autocomplete="name" />
      </div>

      <div class="form__field">
        <label for="email">{t(locale, 'contact.email')}</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>

      {/*
        Розмітка лишається нативною: без JS це звичайний робочий <select>.
        scripts/select.ts підміняє його на власний listbox, бо системний
        випадний список не стилізується — його малює операційна система.
      */}
      <div class="form__field form__field--select" data-select>
        <label for="type">{t(locale, 'contact.type')}</label>
        <select id="type" name="projectType">
          {projectTypes.map((p) => <option value={p}>{p}</option>)}
        </select>
      </div>

      <div class="form__field">
        <label for="message">{t(locale, 'contact.message')}</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>

      <button class="form__submit" type="submit">{t(locale, 'contact.send')}</button>

      <p
        class="form__status t-meta"
        data-form-status
        data-sending={t(locale, 'contact.sending')}
        data-ok={t(locale, 'contact.ok')}
        data-error={`${t(locale, 'contact.error')} ${SITE.email}`}
        role="status"
        aria-live="polite"
      />
    </form>
  </div>
</section>

<script>
  import '../../scripts/contact-form';
  import '../../scripts/select';
</script>

<style>
  .contact {
    position: relative;
    padding-block: var(--section);
    isolation: isolate;
  }

  .contact__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .contact__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /*
      Кадри моря й неба надто яскраві: найсвітліший піксель дає L≈0.7,
      і підписи полів форми (--muted-inv) виходили на 1.57:1 — провал.
      Гасимо саме зображення, а не тільки накладаємо темряву: так контраст
      проходить AA, і при цьому фото лишається помітнішим, ніж під
      суцільним затемненням 0.9.
    */
    filter: brightness(0.4);
  }

  /*
    Затемнення поверх приглушеного фото. Перевірено на обох кадрах:
    у найгіршій точці --bone дає 11.5:1, --muted-inv 4.7:1 — обидва AA.
  */
  .contact__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgb(25 24 23 / 0.74) 0%,
      rgb(25 24 23 / 0.68) 45%,
      rgb(25 24 23 / 0.62) 100%
    );
  }

  .contact__bg-tall {
    display: none;
  }

  @media (max-width: 767px) {
    .contact__bg-wide {
      display: none;
    }

    .contact__bg-tall {
      display: block;
    }
  }

  .contact__type {
    grid-column: span 5;
  }

  .contact__title {
    margin-block: var(--space-s) var(--space-m);
  }

  .contact__details {
    margin: var(--space-xl) 0 0;
    border-top: 1px solid var(--rule);
  }

  .contact__details > div {
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--rule);
  }

  .contact__details dd {
    margin: 0.25rem 0 0;
  }

  .form {
    grid-column: 7 / span 6;
  }

  .form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__field + .form__field {
    margin-top: var(--space-m);
  }

  .form__field label {
    display: block;
    margin-bottom: 0.375rem;
    font-size: var(--step-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .form__field input,
  .form__field select,
  .form__field textarea {
    width: 100%;
    padding: 0.75rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--muted-inv);
    border-radius: 0;
    color: inherit;
    transition: border-color var(--dur) var(--ease);
  }

  .form__field input:focus,
  .form__field select:focus,
  .form__field textarea:focus {
    outline: none;
    border-bottom-color: var(--accent-inv);
  }

  .form__field textarea {
    /* Куточок для розтягування ламав підкреслення поля й тут не потрібен:
       висоти в п'ять рядків вистачає, довший текст просто прокручується. */
    resize: none;
  }

  /* Поки JS не відпрацював — нативний select виглядає як решта полів. */
  .form__field select option {
    background: var(--ink-deep);
    color: var(--bone);
  }

  /* ─── Власний випадний список ─────────────────────────── */

  /*
    Селектори загорнуті в :global().

    Стилі компонента скоповані, і Astro проставляє data-astro-cid лише
    елементам із шаблону. Кнопку та список створює scripts/select.ts уже
    в браузері, тож цього атрибута в них немає — скоповані правила
    у них не влучали взагалі, і поле лишалося зовсім нестилізованим.

    Прив'язку зберігає батьківський .form__field--select: він у шаблоні,
    отже cid має, і правила діють лише всередині цього поля.
  */

  .form__field--select {
    position: relative;
  }

  .form__field--select :global(.sel__button) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    width: 100%;
    padding: 0.75rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--muted-inv);
    border-radius: 0;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }

  .form__field--select.is-open :global(.sel__button),
  .form__field--select :global(.sel__button:focus-visible) {
    border-bottom-color: var(--accent-inv);
  }

  .form__field--select :global(.sel__button:focus-visible) {
    outline: none;
  }

  .form__field--select :global(.sel__chevron) {
    width: 12px;
    height: 8px;
    flex: none;
    color: var(--muted-inv);
    transition: transform var(--dur) var(--ease);
  }

  .form__field--select.is-open :global(.sel__chevron) {
    transform: rotate(180deg);
  }

  /*
    Список непрозорий: секція стоїть на фотографії, і напівпрозоре тло
    зробило б підписи нечитабельними.
  */
  .form__field--select :global(.sel__list) {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 2px);
    z-index: 20;
    margin: 0;
    padding: 0.25rem 0;
    list-style: none;
    background: var(--ink);
    border: 1px solid var(--rule);
    box-shadow: 0 18px 50px -24px rgb(0 0 0 / 0.8);

    /*
      20rem, а не 15: п'ять наявних пунктів займають ~15.8rem, тож смуга
      прокрутки з'являлася там, де могла б не з'являтися взагалі.
      Обмеження лишається на випадок довшого списку.
    */
    max-height: min(60vh, 20rem);
    overflow-y: auto;

    /* Стандартна властивість: Firefox і Chrome від 121. */
    scrollbar-width: thin;
    scrollbar-color: rgb(255 255 255 / 0.22) transparent;
  }

  /* WebKit і старіші Chromium — те саме через власні псевдоелементи. */
  .form__field--select :global(.sel__list::-webkit-scrollbar) {
    width: 6px;
  }

  .form__field--select :global(.sel__list::-webkit-scrollbar-track) {
    background: transparent;
  }

  .form__field--select :global(.sel__list::-webkit-scrollbar-thumb) {
    background: rgb(255 255 255 / 0.22);
  }

  .form__field--select :global(.sel__list::-webkit-scrollbar-thumb:hover) {
    background: rgb(255 255 255 / 0.36);
  }

  /* Явно, а не покладаючись на стиль браузера для [hidden]. */
  .form__field--select :global(.sel__list[hidden]) {
    display: none;
  }

  .form__field--select :global(.sel__option) {
    padding: 0.625rem 1rem;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease);
  }

  .form__field--select :global(.sel__option.is-active) {
    background: rgb(255 255 255 / 0.06);
  }

  .form__field--select :global(.sel__option[aria-selected='true']) {
    color: var(--accent-inv);
  }

  .form__field--select :global(.sel__option[aria-selected='true'])::after {
    content: '·';
    margin-inline-start: 0.5rem;
  }

  .form__submit {
    margin-top: var(--space-l);
    padding: 0.875rem 2rem;
    background: transparent;
    color: inherit;
    border: 1px solid var(--muted-inv);
    border-radius: 999px;
    font-size: var(--step-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }

  .form__submit:hover:not(:disabled) {
    border-color: var(--accent-inv);
    color: var(--accent-inv);
  }

  .form__submit:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .form__status {
    margin-top: var(--space-m);
    min-height: 1.25rem;
    text-transform: none;
    letter-spacing: normal;
  }

  .form__status[data-state='ok'] {
    color: var(--accent-inv);
  }

  @media (max-width: 900px) {
    .contact__type,
    .form {
      grid-column: 1 / -1;
    }

    .form {
      margin-top: var(--space-2xl);
    }
  }
</style>
