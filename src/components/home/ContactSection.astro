---
import { getImage } from 'astro:assets';
import { t, place, localePath, type Locale } from '../../lib/i18n';
import { SITE } from '../../lib/site';
import { CONTACT_BACKDROP, getServices } from '../../lib/services';

interface Props {
  locale: Locale;
  id?: string;
  as?: 'h1' | 'h2';
  eyebrow?: string;
  title?: string;
  /** Сторінка проєкту: назва йде в лист окремим полем, щоб Марина бачила, звідки заявка. */
  project?: string;
  /** Власне фото фону замість стандартного (на сторінці проєкту — його обкладинка). */
  backdrop?: ImageMetadata;
  backdropPosition?: string;
}
const {
  locale,
  as: Heading = 'h2',
  id = 'contact',
  eyebrow = t(locale, 'contact.eyebrow'),
  title = t(locale, 'contact.title'),
  project,
  backdrop,
  backdropPosition,
} = Astro.props;

const { wide, tall } = backdrop ? { wide: backdrop, tall: backdrop } : CONTACT_BACKDROP;
const subject = project ? `VM Design — enquiry about «${project}»` : 'VM Design — new enquiry from the website';

// Одне фото з двома кадрами: вузький — для телефона, широкий — для решти.
// Браузер вантажить лише потрібний; на сторінці контактів (h1) — одразу.
const top = Heading === 'h1';
const variants = async (src: ImageMetadata, widths: number[]) => ({
  avif: await getImage({ src, widths, format: 'avif' }),
  webp: await getImage({ src, widths, format: 'webp' }),
});
const bgWide = wide ? await variants(wide, [1200, 1800, 2600, 3600]) : null;
const bgTall = tall ? await variants(tall, [800, 1200, 1900]) : null;

const serviceOptions = [...getServices(locale).map((s) => s.title), t(locale, 'contact.other')];

// Значення — англійською на всіх мовах, щоб Марині було просто рахувати, звідки приходять заявки.
const sourceOptions = [
  { value: 'Google search', label: t(locale, 'contact.source.google') },
  { value: 'Google Maps', label: t(locale, 'contact.source.maps') },
  { value: 'Instagram', label: t(locale, 'contact.source.instagram') },
  { value: 'Recommendation', label: t(locale, 'contact.source.referral') },
  { value: 'Other', label: t(locale, 'contact.other') },
];
---

<section class="contact on-ink-deep" id={id}>
  {
    wide && bgWide && (
      <div class="contact__bg" aria-hidden="true">
        <picture>
          {bgTall && <source media="(max-width: 767px)" type="image/avif" srcset={bgTall.avif.srcSet.attribute} sizes="230vw" />}
          {bgTall && <source media="(max-width: 767px)" type="image/webp" srcset={bgTall.webp.srcSet.attribute} sizes="230vw" />}
          <source type="image/avif" srcset={bgWide.avif.srcSet.attribute} sizes="100vw" />
          <img
            src={bgWide.webp.src}
            srcset={bgWide.webp.srcSet.attribute}
            sizes="100vw"
            width={wide.width}
            height={wide.height}
            alt=""
            style={backdropPosition && `object-position: ${backdropPosition}`}
            loading={top ? 'eager' : 'lazy'}
            fetchpriority={top ? 'high' : 'auto'}
            decoding="async"
          />
        </picture>
      </div>
    )
  }

  <div class="container grid contact__inner">
    <div class="contact__type" data-reveal>
      <p class="t-eyebrow">{eyebrow}</p>
      <Heading class="t-h2 contact__title">{title}</Heading>
      <p class="t-lead">{t(locale, 'contact.lead')}</p>

      <dl class="contact__details">
        <div>
          <dt class="t-meta">{t(locale, 'contact.phone')}</dt>
          <dd><a class="link" href={SITE.phoneHref}>{SITE.phone}</a></dd>
        </div>
        <div>
          <dt class="t-meta">{t(locale, 'contact.email')}</dt>
          <dd><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
        </div>
        <div>
          <dt class="t-meta">{t(locale, 'contact.instagram')}</dt>
          <dd>
            <a class="link" href={SITE.instagramUrl} rel="me noopener" target="_blank">
              {SITE.instagram}
            </a>
          </dd>
        </div>
        <div>
          <dt class="t-meta">{t(locale, 'contact.workingIn')}</dt>
          <dd>{SITE.regions.map((r) => place(locale, r)).join(' · ')}</dd>
        </div>
      </dl>
    </div>

    <form
      class="form"
      method="POST"
      action={SITE.formAction || undefined}
      data-contact-form
      data-endpoint={SITE.formAction}
      data-reveal
    >
      <input type="hidden" name="_subject" value={subject} />
      {project && <input type="hidden" name="project" value={project} />}
      <div class="form__trap" aria-hidden="true">
        <label for="company">Company</label>
        <input type="text" id="company" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form__field">
        <label for="name">{t(locale, 'contact.name')}</label>
        <input type="text" id="name" name="name" required autocomplete="name" />
      </div>

      <div class="form__field">
        <label for="email">{t(locale, 'contact.email')}</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>

      <div class="form__field form__field--select" data-select>
        <label for="type">{t(locale, 'contact.type')}</label>
        <select id="type" name="service">
          {serviceOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>

      <div class="form__field form__field--select" data-select>
        <label for="source">
          {t(locale, 'contact.source')} <span class="form__optional">({t(locale, 'contact.optional')})</span>
        </label>
        <select id="source" name="source">
          <option value="">—</option>
          {sourceOptions.map((o) => <option value={o.value}>{o.label}</option>)}
        </select>
      </div>

      <div class="form__field">
        <label for="message">{t(locale, 'contact.message')}</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>

      <button class="form__submit" type="submit">{t(locale, 'contact.send')}</button>

      <p class="form__consent">
        {t(locale, 'contact.consent')}{' '}
        <a class="link" href={localePath(locale, '/privacy')}>{t(locale, 'contact.privacyLink')}</a>
      </p>

      <p
        class="form__status t-meta"
        data-form-status
        data-sending={t(locale, 'contact.sending')}
        data-ok={t(locale, 'contact.ok')}
        data-error={`${t(locale, 'contact.error')} ${SITE.email}`}
        role="status"
        aria-live="polite"
      />
    </form>
  </div>

  <dialog class="thanks" aria-labelledby="thanks-title" data-thanks>
    <div class="thanks__inner">
      <svg class="thanks__mark" viewBox="0 0 96 96" aria-hidden="true">
        <circle class="thanks__ring" cx="48" cy="48" r="45" pathLength="1" />
        <path class="thanks__tick" d="M29 49.5 L42 62 L67 35" pathLength="1" />
      </svg>
      <h2 class="thanks__title" id="thanks-title">{t(locale, 'thanks.title')}</h2>
      <p class="thanks__text">{t(locale, 'thanks.text')}</p>
    </div>
    <form class="thanks__corner" method="dialog">
      <button class="thanks__close" type="submit" aria-label={t(locale, 'nav.close')}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 3 L17 17 M17 3 L3 17" /></svg>
      </button>
    </form>
  </dialog>
</section>

<script>
  import '../../scripts/contact-form';
  import '../../scripts/select';
</script>

<style>
  .contact {
    position: relative;
    padding-block: var(--section);
    isolation: isolate;
  }

  .contact__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .contact__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.85);
  }

  .contact__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgb(25 24 23 / 0.72) 0%,
      rgb(25 24 23 / 0.58) 45%,
      rgb(25 24 23 / 0.46) 100%
    );
  }

  @media (max-width: 767px) {
    /* На телефоні текст і форма на всю ширину — шар рівний, без градієнта. */
    .contact__bg::after {
      background: rgb(25 24 23 / 0.62);
    }
  }

  .contact__type {
    grid-column: span 5;
  }

  .contact__title {
    margin-block: var(--space-s) var(--space-m);
  }

  .contact__details {
    margin: var(--space-xl) 0 0;
    border-top: 1px solid var(--rule);
  }

  .contact__details > div {
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--rule);
  }

  .contact__details dd {
    margin: 0.25rem 0 0;
  }

  .form {
    grid-column: 7 / span 6;
  }

  .form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__field + .form__field {
    margin-top: var(--space-m);
  }

  .form__field label {
    display: block;
    margin-bottom: 0.375rem;
    font-size: var(--step-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .form__optional {
    text-transform: none;
    letter-spacing: normal;
    opacity: 0.75;
  }

  .form__field input,
  .form__field select,
  .form__field textarea {
    width: 100%;
    padding: 0.75rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--muted-inv);
    border-radius: 0;
    color: inherit;
    transition: border-color var(--dur) var(--ease);
  }

  .form__field input:focus,
  .form__field select:focus,
  .form__field textarea:focus {
    outline: none;
    border-bottom-color: var(--accent-inv);
  }

  .form__field textarea {
    resize: none;
  }

  .form__field select option {
    background: var(--ink-deep);
    color: var(--bone);
  }

  .form__field--select {
    position: relative;
  }

  .form__field--select :global(.sel__button) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    width: 100%;
    padding: 0.75rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--muted-inv);
    border-radius: 0;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }

  .form__field--select.is-open :global(.sel__button),
  .form__field--select :global(.sel__button:focus-visible) {
    border-bottom-color: var(--accent-inv);
  }

  .form__field--select :global(.sel__button:focus-visible) {
    outline: none;
  }

  .form__field--select :global(.sel__chevron) {
    width: 12px;
    height: 8px;
    flex: none;
    color: var(--muted-inv);
    transition: transform var(--dur) var(--ease);
  }

  .form__field--select.is-open :global(.sel__chevron) {
    transform: rotate(180deg);
  }

  .form__field--select :global(.sel__list) {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 2px);
    z-index: 20;
    margin: 0;
    padding: 0.25rem 0;
    list-style: none;
    background: var(--ink);
    border: 1px solid var(--rule);
    box-shadow: 0 18px 50px -24px rgb(0 0 0 / 0.8);

    max-height: min(60vh, 24rem);
    overflow-y: auto;

    scrollbar-width: thin;
    scrollbar-color: rgb(255 255 255 / 0.22) transparent;
  }

  .form__field--select :global(.sel__list::-webkit-scrollbar) {
    width: 6px;
  }

  .form__field--select :global(.sel__list::-webkit-scrollbar-track) {
    background: transparent;
  }

  .form__field--select :global(.sel__list::-webkit-scrollbar-thumb) {
    background: rgb(255 255 255 / 0.22);
  }

  .form__field--select :global(.sel__list::-webkit-scrollbar-thumb:hover) {
    background: rgb(255 255 255 / 0.36);
  }

  .form__field--select :global(.sel__list[hidden]) {
    display: none;
  }

  .form__field--select :global(.sel__option) {
    padding: 0.625rem 1rem;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease);
  }

  .form__field--select :global(.sel__option.is-active) {
    background: rgb(255 255 255 / 0.06);
  }

  .form__field--select :global(.sel__option[aria-selected='true']) {
    color: var(--accent-inv);
  }

  .form__submit {
    margin-top: var(--space-l);
    padding: 0.875rem 2rem;
    background: transparent;
    color: inherit;
    border: 1px solid var(--muted-inv);
    border-radius: 999px;
    font-size: var(--step-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }

  .form__submit:hover:not(:disabled) {
    border-color: var(--accent-inv);
    color: var(--accent-inv);
  }

  .form__submit:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .form__consent {
    margin-top: var(--space-m);
    font-size: var(--step-small);
    color: var(--muted-inv);
  }

  .form__consent .link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .form__status {
    margin-top: var(--space-m);
    min-height: 1.25rem;
    text-transform: none;
    letter-spacing: normal;
  }

  .form__status[data-state='ok'] {
    color: var(--accent-inv);
  }

  /* Подяка після відправлення: на весь екран, світла, з галочкою, що малюється. */
  .thanks {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--gutter);
    border: 0;
    background: var(--bone);
    color: var(--ink);
    --focus: var(--accent);
  }

  .thanks[open] {
    display: grid;
    place-items: center;
    animation: thanks-in 600ms var(--ease) both;
  }

  /* Закривається сама: коротке згасання перед close() (див. contact-form.ts). */
  .thanks.is-closing {
    animation: thanks-out 500ms var(--ease) forwards;
  }

  .thanks::backdrop {
    background: transparent;
  }

  :global(html:has(.thanks[open])) {
    overflow: hidden;
  }

  .thanks__inner {
    max-width: 34rem;
    text-align: center;
  }

  .thanks__mark {
    width: clamp(4.5rem, 10vw, 6rem);
    height: auto;
    margin-inline: auto;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .thanks__ring,
  .thanks__tick {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .thanks[open] .thanks__ring {
    transform: rotate(-90deg);
    transform-origin: center;
    animation: thanks-draw 900ms var(--ease) 250ms forwards;
  }

  .thanks[open] .thanks__tick {
    stroke-width: 2;
    animation: thanks-draw 500ms var(--ease) 950ms forwards;
  }

  .thanks__title {
    margin: var(--space-l) 0 var(--space-s);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-h1);
    line-height: var(--lh-heading);
  }

  .thanks__text {
    margin: 0;
    font-size: var(--step-lead);
    line-height: var(--lh-lead);
    color: var(--muted);
  }

  .thanks__title,
  .thanks__text {
    animation: thanks-rise 700ms var(--ease) both;
  }

  .thanks__title {
    animation-delay: 700ms;
  }

  .thanks__text {
    animation-delay: 820ms;
  }

  .thanks__corner {
    position: absolute;
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
  }

  .thanks__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: transparent;
    border: 0;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease);
  }

  .thanks__close:hover {
    color: var(--ink);
  }

  .thanks__close svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }

  @keyframes thanks-in {
    from {
      opacity: 0;
    }
  }

  @keyframes thanks-out {
    to {
      opacity: 0;
    }
  }

  @keyframes thanks-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes thanks-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thanks[open],
    .thanks[open] .thanks__ring,
    .thanks[open] .thanks__tick,
    .thanks__title,
    .thanks__text,
    .thanks.is-closing {
      animation: none;
    }

    .thanks__ring,
    .thanks__tick {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 900px) {
    .contact__type,
    .form {
      grid-column: 1 / -1;
    }

    .form {
      margin-top: var(--space-2xl);
    }
  }
</style>
