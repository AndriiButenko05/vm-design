---
import { getImage } from 'astro:assets';
import './CircularGallery.css';
import { t, type Locale } from '../../lib/i18n';
import type { Project } from '../../lib/projects';

interface Props {
  locale: Locale;
  projects: Project[];
  id?: string;
}

const { locale, projects, id } = Astro.props;

const MAX = 14;

const picked = projects
  .flatMap((project) =>
    project.data.gallery
      .filter((g) => g.material)
      .map((g) => ({ frame: g, project })),
  )
  .slice(0, MAX);

const items = await Promise.all(
  picked.map(async ({ frame }) => {
    const img = await getImage({ src: frame.src, width: 800, format: 'webp' });
    return { image: img.src, text: frame.material! };
  }),
);
---

{
  items.length > 0 && (
    <section class="materials section" id={id}>
      <div class="container materials__head" data-reveal>
        <p class="t-eyebrow">{t(locale, 'materials.eyebrow')}</p>
        <h2 class="t-h2">{t(locale, 'materials.title')}</h2>
      </div>

      <div class="materials__stage">
        <div
          class="circular-gallery"
          data-circular-gallery
          data-config={JSON.stringify({
            items,
            bend: 2,
            textColor: '#2b2a29',
            borderRadius: 0.04,
            scrollEase: 0.05,
            scrollSpeed: 2,
            font: "400 72px 'Spectral'",
          })}
          tabindex="0"
          role="region"
          aria-label="Circular image gallery. Use Left and Right Arrow keys to navigate."
        ></div>
      </div>
    </section>
  )
}

<script>
  const el = document.querySelector<HTMLElement>('[data-circular-gallery]');
  if (el) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        import('../../scripts/circular-gallery').then(({ mountCircularGallery }) =>
          mountCircularGallery(el, JSON.parse(el.dataset.config!)),
        );
      },
      { rootMargin: '200px' },
    );
    io.observe(el);
  }
</script>

<style>
  .materials__head {
    margin-bottom: 0;
  }

  .materials__head .t-eyebrow {
    margin-bottom: var(--space-s);
  }

  .materials__stage {
    position: relative;
    height: clamp(360px, 46vh, 560px);
  }
</style>
