---
import { Picture } from 'astro:assets';
import ArrowNav from '../ui/ArrowNav.astro';
import { t, type Locale } from '../../lib/i18n';
import type { Project } from '../../lib/projects';

interface Props {
  locale: Locale;
  pairs: NonNullable<Project['data']['beforeAfter']>['pairs'];
}

const { locale, pairs } = Astro.props;

/**
 * Пропорція кадру береться з самої пари, а не задається наперед.
 *
 * «До» і «після» рідко мають однакову пропорцію: у La Villa це 4:3 проти
 * 16:9. Середнє арифметичне двох пропорцій лишає обидва кадри майже
 * неторканими, а object-fit: cover добирає решту.
 *
 * Ракурси в парах можуть не збігатися — так і задумано: замовниця хоче
 * показати, як змінилося приміщення, а не точну накладку двох знімків.
 */
const stageRatio = (pair: (typeof pairs)[number]) =>
  (pair.before.width / pair.before.height + pair.after.width / pair.after.height) / 2;

const multiple = pairs.length > 1;
---

<section class="ba section">
  <div class="container">
    <header class="ba__head" data-reveal>
      <p class="t-eyebrow">{t(locale, 'ba.eyebrow')}</p>
      <h2 class="t-subhead">{t(locale, 'ba.title')}</h2>
    </header>

    <div
      class="ba__carousel"
      data-carousel
      data-ba-carousel
      data-reveal
      role="region"
      aria-roledescription="carousel"
      aria-label={t(locale, 'ba.title')}
    >
      {
        pairs.map((pair, i) => (
          <figure
            class="slider"
            data-ba
            data-carousel-slide
            data-caption={pair.caption ?? ''}
            hidden={i > 0}
            aria-label={`${i + 1} / ${pairs.length}`}
            style={`--ar:${stageRatio(pair).toFixed(4)}`}
          >
            <div class="slider__stage">
              <span class="slider__layer slider__layer--after">
                <Picture
                  formats={['avif']}
                  fallbackFormat="webp"
                  src={pair.after}
                  alt={`${t(locale, 'ba.after')}${pair.caption ? ` — ${pair.caption}` : ''}`}
                  widths={[600, 1000, 1500]}
                  sizes="(max-width: 900px) 92vw, 70vw"
                  loading="lazy"
                />
              </span>
              <span class="slider__layer slider__layer--before">
                <Picture
                  formats={['avif']}
                  fallbackFormat="webp"
                  src={pair.before}
                  alt={`${t(locale, 'ba.before')}${pair.caption ? ` — ${pair.caption}` : ''}`}
                  widths={[600, 1000, 1500]}
                  sizes="(max-width: 900px) 92vw, 70vw"
                  loading="lazy"
                />
              </span>

              <span class="slider__handle" aria-hidden="true" />

              <label class="visually-hidden" for={`ba-${i}`}>
                {t(locale, 'ba.drag')}
              </label>
              <input
                id={`ba-${i}`}
                class="slider__range"
                type="range"
                min="0"
                max="100"
                value="50"
                step="0.1"
              />

              <span class="slider__tag slider__tag--before">{t(locale, 'ba.before')}</span>
              <span class="slider__tag slider__tag--after">{t(locale, 'ba.after')}</span>
            </div>
          </figure>
        ))
      }

      <div class="ba__bar">
        <p class="ba__caption" data-carousel-caption>{pairs[0]?.caption}</p>
        {multiple && <ArrowNav total={pairs.length} prevLabel={t(locale, 'ba.prev')} nextLabel={t(locale, 'ba.next')} />}
      </div>
      <p class="ba__hint">{t(locale, 'ba.hint')}</p>
    </div>
  </div>
</section>

<script>
  import '../../scripts/carousel';
  import '../../scripts/before-after';
</script>

<style>
  .ba__head {
    margin-bottom: var(--space-l);
  }

  .ba__head .t-eyebrow {
    margin-bottom: 0.75rem;
  }

  /* ─── Підпис, стрілки, підказка ────────────────────────── */

  .ba__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    margin-top: var(--space-s);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--rule);
  }

  .ba__caption {
    margin: 0;
    font-size: var(--step-small);
    color: var(--fg-muted);
  }

  .ba__hint {
    margin: 0.625rem 0 0;
    font-size: var(--step-meta);
    color: var(--fg-muted);
  }

  /* Стрілки без JS нічого не гортають — ховаємо до ініціалізації. */
  .ba__carousel:not([data-carousel-ready]) :global(.arrows) {
    visibility: hidden;
  }

  /* ─── Повзунок ─────────────────────────────────────────── */

  /*
    Висота сцени однакова для всіх пар (до 78vh), ширина — за пропорцією
    пари. Так при гортанні не стрибає все, що нижче: змінюється лише
    ширина кадру. Вертикальна пара на широкому екрані інакше виросла б
    на два екрани заввишки.
  */
  .slider {
    width: 100%;
    max-width: calc(min(78vh, 760px) * var(--ar, 1));
    margin: 0 auto;
  }

  .slider__stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ar, 1);
    background: var(--sand);
  }

  .slider__layer {
    position: absolute;
    inset: 0;
  }

  .slider__layer :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* «До» лежить зверху і обрізається праворуч за положенням повзунка. */
  .slider__layer--before {
    clip-path: inset(0 calc(100% - var(--pos, 50%)) 0 0);
  }

  .slider__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos, 50%);
    width: 2px;
    background: var(--paper);
    box-shadow: 0 0 3px rgb(25 24 23 / 0.45);
    transform: translateX(-1px);
    pointer-events: none;
  }

  /* Кружок зі стрілками обабіч — як у макеті. */
  .slider__handle::after {
    content: '‹ ›';
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--bone);
    color: var(--ink);
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: 0.1em;
    box-shadow: 0 2px 8px rgb(25 24 23 / 0.25);
  }

  /* Нативний range розтягнуто на весь кадр і зроблено невидимим:
     він лишається реальним елементом керування, а видимою є смуга вище. */
  .slider__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
    appearance: none;
    cursor: ew-resize;
  }

  .slider__range::-webkit-slider-thumb {
    appearance: none;
    width: 3rem;
    height: 100%;
    cursor: ew-resize;
  }

  .slider__range::-moz-range-thumb {
    width: 3rem;
    height: 100%;
    border: 0;
    background: transparent;
    cursor: ew-resize;
  }

  .slider__range:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  .slider__tag {
    position: absolute;
    bottom: 0.75rem;
    padding: 0.375rem 0.625rem;
    background: var(--bone);
    color: var(--ink);
    font-size: var(--step-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    pointer-events: none;
  }

  .slider__tag--before {
    left: 0.75rem;
  }

  .slider__tag--after {
    right: 0.75rem;
  }

  @media (max-width: 700px) {
    .ba__bar {
      align-items: flex-start;
    }
  }
</style>
