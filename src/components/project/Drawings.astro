---
import { Picture, getImage } from 'astro:assets';
import { previewSheets, totalPages, viewerPath, type DrawingSet } from '../../lib/drawings';
import { localePath, t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  project: string;
  sets: DrawingSet[];
  picks?: string[];
}

const { locale, project, sets, picks } = Astro.props;

const sheets = await previewSheets(sets, picks);
const total = totalPages(sets);

const hasMore = total > sheets.length;

const full = await Promise.all(sheets.map((s) => getImage({ src: s.img, width: 1500, format: 'webp' })));
const fullAvif = await Promise.all(sheets.map((s) => getImage({ src: s.img, width: 1500, format: 'avif' })));
---

<section class="dwg section">
  <div class="container">
    <header class="dwg__head" data-reveal>
      <p class="t-eyebrow">{t(locale, 'dwg.eyebrow')}</p>
      <h2 class="t-subhead">{t(locale, 'dwg.title')}</h2>
      <p class="dwg__text">{t(locale, 'dwg.text')}</p>
    </header>

    <ul class="dwg__grid" data-reveal>
      {
        sheets.map((sheet, i) => (
          <li>
            <button
              type="button"
              class="dwg__sheet"
              data-lightbox-open
              data-lightbox-group="drawings"
              data-full={full[i].src}
              data-full-avif={fullAvif[i].src}
              data-alt={`${sheet.set.title} — ${t(locale, 'dwg.sheet')}`}
              data-w={sheet.img.width}
              data-h={sheet.img.height}
              aria-label={`${sheet.set.title} — ${t(locale, 'dwg.sheet')} — ${t(locale, 'renders.zoom')}`}
            >
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={sheet.img}
                alt={`${sheet.set.title} — ${t(locale, 'dwg.sheet')}`}
                widths={[400, 700, 1000]}
                sizes="(max-width: 700px) 92vw, 30vw"
                loading="lazy"
              />
            </button>
          </li>
        ))
      }
    </ul>

    <div class="dwg__bar">
      <span class="dwg__count">{total} {t(locale, 'dwg.sheets')}</span>
      {
        hasMore && (
          <a class="dwg__all" href={localePath(locale, viewerPath(project))} target="_blank" rel="noopener">
            {t(locale, 'dwg.all')}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16 L16 8 M9 8 H16 V15" /></svg>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .dwg__head {
    margin-bottom: var(--space-l);
  }

  .dwg__head .t-eyebrow {
    margin-bottom: 0.75rem;
  }

  .dwg__text {
    max-width: 56ch;
    margin-top: var(--space-s);
    color: var(--fg-muted);
  }

  .dwg__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dwg__sheet {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: var(--space-s);
    border: 0;
    background: var(--sand);
    cursor: zoom-in;
  }

  .dwg__sheet :global(picture) {
    display: contents;
  }

  .dwg__sheet :global(img) {
    min-width: 0;
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08);
    transition: transform var(--dur) var(--ease);
  }

  .dwg__sheet:hover :global(img) {
    transform: scale(1.02);
  }

  .dwg__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-m);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--rule);
  }

  .dwg__count {
    font-size: var(--step-small);
    color: var(--fg-muted);
  }

  .dwg__all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.375rem;
    border: 1px solid var(--fg);
    font-size: var(--step-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--fg);
    text-decoration: none;
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .dwg__all:hover,
  .dwg__all:focus-visible {
    background: var(--fg);
    color: var(--bg);
  }

  .dwg__all svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  @media (max-width: 700px) {
    .dwg__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
