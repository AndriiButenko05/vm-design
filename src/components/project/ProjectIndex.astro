---
import { Picture } from 'astro:assets';
import { slugOf, type Project } from '../../lib/projects';
import { localePath, t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  projects: Project[];
}

const { locale, projects } = Astro.props;
---

{/*
  Не сітка карток, а покажчик — як у каталозі виставки.
  Прев'ю відкривається вертикальною плитою: 137 зі 151 кадру
  в партії вертикальні, тож портретне прев'ю тут не компроміс,
  а форма, що збігається з матеріалом.
*/}
<div class="index" data-index>
  <ol class="index__rows">
    {
      projects.map((p, i) => (
        <li class="index__row" data-index-row={slugOf(p)}>
          <a href={localePath(locale, `/projects/${slugOf(p)}`)}>
            <span class="index__num t-meta">{String(i + 1).padStart(2, '0')}</span>
            <span class="index__title">{p.data.title}</span>
            <span class="index__meta t-meta">{p.data.city}</span>
            <span class="index__meta index__meta--type t-meta">{t(locale, `type.${p.data.type}`)}</span>
            <span class="index__meta index__meta--year t-meta">{p.data.year ?? ''}</span>

            {/* Плитка всередині рядка — вона ж прев'ю на вузьких екранах. */}
            <span class="index__inline plate plate--portrait" style={`--placeholder:${'#2b2a29'}`}>
              <Picture formats={['avif']} fallbackFormat="webp" src={p.data.cover} alt="" widths={[280, 560]} sizes="140px" loading="lazy" />
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  {/* Прев'ю для вказівника. Приховане від скрінрідерів — дублює текст рядка. */}
  <div class="index__preview" aria-hidden="true" data-index-preview>
    {
      projects.map((p) => (
        <span class="index__plate plate" data-preview-for={slugOf(p)}>
          <Picture formats={['avif']} fallbackFormat="webp" src={p.data.cover} alt="" widths={[400, 800]} sizes="320px" loading="lazy" />
        </span>
      ))
    }
  </div>
</div>

<script>
  import '../../scripts/index-preview';
</script>

<style>
  .index {
    position: relative;
  }

  .index__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .index__row {
    border-bottom: 1px solid var(--rule);
  }

  /*
    Колонка типу — 14rem, а не 10rem.

    Назви категорій подовшали на прохання замовниці: замість
    «Commercial» тепер «Commercial & Beauty Spaces». У 10rem таке
    не вміщалося й ламалося на два рядки посеред таблиці.
  */
  .index__row a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 8rem 14rem 4rem;
    align-items: center;
    gap: var(--space-m);
    padding-block: clamp(1rem, 2.4vw, 1.75rem);
    transition: color var(--dur) var(--ease);
  }

  .index__row a:hover,
  .index__row a:focus-visible {
    color: var(--link);
  }

  .index__num {
    color: var(--fg-muted);
  }

  .index__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: var(--ls-display);
  }

  /* Плитка в рядку потрібна лише там, де немає вказівника. */
  .index__inline {
    display: none;
  }

  .index__preview {
    position: absolute;
    top: 0;
    right: 0;
    width: clamp(220px, 22vw, 320px);
    aspect-ratio: var(--ratio-plate);
    pointer-events: none;
    z-index: 2;
  }

  .index__plate {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .index__plate.is-active {
    opacity: 1;
    transform: none;
  }

  .index__plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Прев'ю має сенс лише за наявності вказівника та місця. */
  @media (max-width: 1100px), (hover: none) {
    .index__preview {
      display: none;
    }

    .index__inline {
      display: block;
      width: 140px;
      grid-row: 1 / span 2;
    }

    .index__row a {
      grid-template-columns: 140px minmax(0, 1fr);
      gap: var(--space-m);
      align-items: start;
    }

    .index__num {
      display: none;
    }

    .index__meta--type,
    .index__meta--year {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index__plate {
      transform: none;
    }
  }
</style>
