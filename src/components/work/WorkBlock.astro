---
import { Picture } from 'astro:assets';
import { localePath, t, type Locale } from '../../lib/i18n';

export interface RailItem {
  href: string;
  title: string;
  meta: string;
  image: ImageMetadata;
  alt: string;
}

interface Props {
  locale: Locale;
  index: number;
  titleKey: string;
  textKey: string;
  href: string;
  items: RailItem[];
  reverse?: boolean;
  anchor?: string;
}

const { locale, index, titleKey, textKey, href, items, reverse = false, anchor } = Astro.props;
const num = String(index).padStart(2, '0');
---

<section
  class:list={['work', reverse && 'work--reverse']}
  id={anchor}
  data-swiper
  data-swiper-align={reverse ? 'end' : 'start'}
>
  <div class="container work__inner">
    <header class="work__type" data-reveal>
      <p class="t-meta work__num">{num}</p>
      <h2 class="t-h2">{t(locale, titleKey)}</h2>
      <p class="work__text">{t(locale, textKey)}</p>

      <p class="work__actions">
        <a class="work__cta" href={localePath(locale, href)}>
          {t(locale, 'work.viewAll')} <span aria-hidden="true">·</span> {items.length}
        </a>
      </p>

      <div class="work__nav">
        <button type="button" data-swiper-prev aria-label={t(locale, 'work.prev')}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 4 L7 12 L15 20" />
          </svg>
        </button>
        <button type="button" data-swiper-next aria-label={t(locale, 'work.next')}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 4 L17 12 L9 20" />
          </svg>
        </button>
      </div>
    </header>

    <div class="work__side" data-reveal>
      <div class="work__rail">
        <ul class="rail" data-swiper-rail tabindex="0">
          {
            items.map((it) => (
              <li class="rail__item">
                <a class="tile" href={localePath(locale, it.href)}>
                  <span class="tile__figure">
                    <span class="tile__canvas">
                      <span class="tile__face">
                        <Picture
                          formats={['avif']}
                          fallbackFormat="webp"
                          src={it.image}
                          alt={it.alt}
                          widths={[400, 800, 1200]}
                          sizes="(max-width: 700px) 72vw, 400px"
                          loading="lazy"
                        />
                      </span>

                      <span class="tile__side" aria-hidden="true">
                        <Picture
                          formats={['avif']}
                          fallbackFormat="webp"
                          src={it.image}
                          alt=""
                          widths={[400, 800, 1200]}
                          sizes="(max-width: 700px) 72vw, 400px"
                          loading="lazy"
                        />
                      </span>
                    </span>
                  </span>
                  <span class="tile__caption">
                    <span class="tile__title">{it.title}</span>
                    <span class="t-meta">{it.meta}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  .work {
    --col-gap: clamp(2rem, 6.4vw, 6.75rem);
    --text-col: 0.3636;

    --plate: clamp(240px, 26vw, 400px);
    --plate-gap: clamp(1rem, 1.7vw, 2rem);

    --thick: 24px;
    --tilt: 26deg;
    --persp: 1000px;

    --rail-pad: clamp(2rem, 3.2vw, 3.75rem);
    --rail-top: var(--rail-pad);
    --rail-bottom: 20px;

    --rail-bleed: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));

    position: relative;
    padding-block: var(--section);

    overflow-x: clip;
  }

  .work::before {
    content: '';
    position: absolute;
    top: var(--section);
    bottom: var(--section);
    left: 0;
    right: 0;
    background: var(--sand);
    z-index: -1;
  }

  .work__inner {
    display: flex;
    gap: var(--col-gap);
    align-items: flex-start;
  }

  .work--reverse .work__inner {
    flex-direction: row-reverse;
  }

  .work__type {
    flex: 0 0 calc((100% - var(--col-gap)) * var(--text-col));
    align-self: center;
  }

  .work__side {
    flex: 1 1 0;
    min-width: 0;
  }

  .work__num {
    color: var(--accent-line);
    margin-bottom: var(--space-s);
  }

  .work__text {
    margin-top: var(--space-m);
    max-width: 38ch;
    font-size: clamp(1.0625rem, 0.95rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--fg-muted);
  }

  .work__actions {
    margin-top: var(--space-l);
  }

  .work__cta {
    display: inline-block;
    padding: 1.0625rem 2.25rem;
    border: 1px solid var(--slate);
    border-radius: 66px;
    font-size: var(--step-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .work__cta:hover,
  .work__cta:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .work__rail {
    margin-inline-end: calc(var(--rail-bleed) * -1);
  }

  .work--reverse .work__rail {
    margin-inline: calc(var(--rail-bleed) * -1) 0;
  }

  .rail {
    display: flex;
    gap: var(--plate-gap);
    list-style: none;
    margin: 0;
    padding: var(--rail-top) 0 var(--rail-bottom) var(--thick);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: var(--thick);
    scrollbar-width: none;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  .rail__item {
    flex: 0 0 var(--plate);
    scroll-snap-align: start;
    perspective: var(--persp);
  }

  .work--reverse .rail__item {
    scroll-snap-align: end;
  }

  .tile {
    display: block;
  }

  .tile__figure {
    display: block;
    filter: drop-shadow(15px 20px 22px rgb(0 0 0 / 0.22));
    transition: transform var(--dur-slow) var(--ease);
  }

  .tile__canvas {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 8 / 11;
    transform-style: preserve-3d;
    transform: perspective(var(--persp)) rotateY(var(--tilt));
  }

  .tile__face,
  .tile__side {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
  }

  .tile__face {
    width: 100%;
    overflow: hidden;
    transform: translateZ(0);
  }

  .tile__face :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--placeholder, var(--stone));
  }

  .tile__side {
    width: var(--thick);
    overflow: hidden;
    transform-origin: left center;
    transform: rotateY(90deg);
    filter: brightness(0.7) contrast(1.1);
  }

  .tile__side :global(img) {
    display: block;
    width: var(--plate);
    height: 100%;
    object-fit: cover;
    object-position: left center;
    transform: scaleX(-1);
  }

  .tile:hover .tile__figure,
  .tile:focus-visible .tile__figure {
    transform: translateY(-8px);
  }

  .tile__caption {
    display: block;
    margin-top: var(--space-m);
    text-align: center;
  }

  .tile__title {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
  }

  .work__nav {
    display: none;
    gap: 1.25rem;
    margin-top: var(--space-l);
  }

  [data-swiper-ready] .work__nav {
    display: flex;
  }

  .work__nav button {
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }

  .work__nav svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: square;
  }

  .work__nav button:hover:not(:disabled) {
    color: var(--accent);
  }

  .work__nav button:disabled {
    opacity: 0.25;
    cursor: default;
  }

  @media (max-width: 900px) {
    .work {
      padding-block: var(--section) 20px;
    }

    .work::before {
      top: 0;
      bottom: 0;
    }

    .work__inner,
    .work--reverse .work__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 2rem;
    }

    .work__type,
    .work__side {
      flex: 0 0 auto;
    }

    .work__rail,
    .work--reverse .work__rail {
      margin-inline: calc(var(--gutter) * -1);
    }

    .rail,
    .work--reverse .rail {
      padding-inline: calc(var(--gutter) + var(--thick)) var(--gutter);
      scroll-padding-inline-start: calc(var(--gutter) + var(--thick));
    }

    .work--reverse .rail__item {
      scroll-snap-align: start;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .tile:hover .tile__figure,
    .tile:focus-visible .tile__figure {
      transform: none;
    }
  }
</style>
