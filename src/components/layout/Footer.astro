---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-light.png';
import { localePath, t, type Locale } from '../../lib/i18n';
import { SITE } from '../../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();

const sections = [
  { hash: 'studio', key: 'about.eyebrow' },
  { hash: 'projects', key: 'index.title' },
  { hash: 'services', key: 'services.eyebrow' },
  { hash: 'materials', key: 'materials.eyebrow' },
];
---

<footer class="footer on-ink-deep">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Image src={logo} width={56} height={56} densities={[1, 2, 3]} alt="" />
      <p class="t-meta">VM Design</p>
    </div>

    <div class="footer__col">
      <p class="t-meta">{t(locale, 'contact.eyebrow')}</p>
      <p>
        <a class="link" href={SITE.phoneHref}>{SITE.phone}</a>
      </p>
      <p>
        <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      <p>
        <a class="link" href={SITE.instagramUrl} rel="me noopener" target="_blank">
          {SITE.instagram}
        </a>
      </p>
    </div>

    <nav class="footer__col" aria-label={t(locale, 'aria.pages')}>
      <p class="t-meta">{t(locale, 'index.title')}</p>
      <ul>
        <li><a class="link" href={localePath(locale, '/projects')}>{t(locale, 'nav.work')}</a></li>
        <li><a class="link" href={localePath(locale, '/services')}>{t(locale, 'nav.services')}</a></li>
        <li><a class="link" href={localePath(locale, '/about')}>{t(locale, 'nav.about')}</a></li>
        <li><a class="link" href={localePath(locale, '/contact')}>{t(locale, 'nav.contact')}</a></li>
      </ul>
    </nav>

    <nav class="footer__col footer__col--sections" aria-label={t(locale, 'aria.sections')}>
      <p class="t-meta">{t(locale, 'footer.sections')}</p>
      <ul>
        {
          sections.map((s) => (
            <li>
              <a class="link" href={`${localePath(locale, '/')}#${s.hash}`}>{t(locale, s.key)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__legal t-meta">
      <p>© {year} VM Design{SITE.legal.vat && ` · P.IVA ${SITE.legal.vat}`}</p>
      <p class="footer__legal-links">
        <a class="link" href={localePath(locale, '/legal')}>{t(locale, 'footer.legal')}</a>
        <a class="link" href={localePath(locale, '/privacy')}>{t(locale, 'footer.privacy')}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: auto 1fr 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }


  .footer__brand img {
    width: 56px;
    height: 56px;
  }

  .footer__brand p {
    margin-top: var(--space-s);
  }

  .footer__col .t-meta {
    margin-bottom: var(--space-s);
  }

  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__col li + li,
  .footer__col p + p {
    margin-top: 0.375rem;
  }

  .footer__legal {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    padding-top: var(--space-l);
    border-top: 1px solid var(--rule);
  }

  .footer__legal p {
    max-width: none;
  }

  .footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
  }

  @media (max-width: 700px) {
    .footer__inner {
      grid-template-columns: repeat(2, auto);
      justify-content: center;
      gap: var(--space-l) var(--space-xl);
      align-items: start;
    }
  }
</style>
