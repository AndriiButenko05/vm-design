---
import '../../styles/tokens.css';
import '../../styles/fonts.css';
import '../../styles/base.css';

import { getImage } from 'astro:assets';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { resolveLocale, stripLocale, LOCALES, localePath, t, type Locale } from '../../lib/i18n';
import { OG_LOCALE, siteGraph } from '../../lib/seo';
import defaultOgImage from '../../assets/hero/01-villa-staircase.jpg';

interface Props {
  title: string;
  description: string;
  transparentHeader?: boolean;
  noindex?: boolean;
  ogImage?: ImageMetadata;
  jsonLd?: Record<string, unknown>[];
  /** Мови, якими сторінка існує (напр. лише ['fr'] для лендингу під Ніццу) — лише їх показуємо в hreflang. */
  locales?: readonly Locale[];
}

const {
  title,
  description,
  transparentHeader = false,
  noindex = false,
  ogImage,
  jsonLd = [],
  locales = LOCALES,
} = Astro.props;

const locale = resolveLocale(Astro.currentLocale, Astro.url);
const bare = stripLocale(Astro.url.pathname);
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(localePath(locale, bare));

const ogRendered = await getImage({
  src: ogImage ?? defaultOgImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 80,
});
const og = abs(ogRendered.src);

const structured = noindex
  ? null
  : JSON.stringify({ '@context': 'https://schema.org', '@graph': [...siteGraph(site, locale), ...jsonLd] });
---

<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'max-image-preview:large'} />
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {locales.map((l) => (
            <link rel="alternate" hreflang={l} href={abs(localePath(l, bare))} />
          ))}
          {locales.includes('en') && (
            <link rel="alternate" hreflang="x-default" href={abs(localePath('en', bare))} />
          )}
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VM Design" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {structured && <script is:inline type="application/ld+json" set:html={structured} />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/brand/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/brand/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta name="theme-color" content="#2b2a29" />

    <link
      rel="preload"
      href="/fonts/spectral-400-latin-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-tight-300-600-latin-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <slot name="head" />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t(locale, 'skip')}</a>
    <Header locale={locale} transparent={transparentHeader} locales={locales} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      import '../../scripts/reveal';
      import '../../scripts/header';
      import '../../scripts/mobile-nav';
    </script>
  </body>
</html>
