---
import { Picture } from 'astro:assets';
import { buildSheets, cityId } from '../../lib/map';
import { groupByCity, slugOf, type Project } from '../../lib/projects';
import { localePath, t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  projects: Project[];
  id?: string;
}

const { locale, projects, id } = Astro.props;

const groups = groupByCity(projects);
const { sheets, beyond } = buildSheets(groups, t(locale, 'map.riviera'));

const typeLabel = (p: Project) => t(locale, `type.${p.data.type}`);
const countLabel = (n: number) => `${n} ${t(locale, n === 1 ? 'map.project' : 'map.projects')}`;
const total = (s: (typeof sheets)[number]) => s.groups.reduce((n, g) => n + g.projects.length, 0);
---

<section class="geo on-ink-deep section" id={id} data-map>
  <div class="container">
    <header class="geo__head" data-reveal>
      <p class="t-eyebrow">{t(locale, 'map.eyebrow')}</p>
      <h2 class="t-h2">{t(locale, 'map.title')}</h2>
    </header>

    <div class="geo__body">
      <div class="geo__figure" data-reveal style={`--map-ratio:${sheets[0].geometry.width / sheets[0].geometry.height}`}>
        {
          sheets.map((sheet, i) => (
            <svg
              data-map-sheet={sheet.id}
              viewBox={sheet.geometry.viewBox}
              role="img"
              aria-label={`${t(locale, sheet.labelKey)} — ${sheet.groups.map((g) => g.city).join(', ')}`}
              hidden={i > 0}
            >
              <g class="geo__regions">
                {sheet.geometry.regions.map((r) => (
                  <path d={r.d} data-region={r.key}>
                    <title>{r.label}</title>
                  </path>
                ))}
              </g>
              <g class="geo__outline">
                {sheet.geometry.outline.map((o) => (
                  <path d={o.d} data-country={o.key} />
                ))}
              </g>
              <g class="geo__markers">
                {sheet.markers.map((m) => (
                  <g
                    class:list={['marker', `marker--${m.side}`, m.goto && 'marker--goto']}
                    data-marker={m.id}
                    data-goto={m.goto}
                    transform={`translate(${m.x} ${m.y})`}
                    role="button"
                    tabindex="0"
                    aria-label={`${m.label} — ${countLabel(m.count)}`}
                  >
                    <circle class="marker__hit" r="22" />
                    <circle class="marker__halo" r="20" />
                    <circle class="marker__dot" r={m.goto ? 11 : 7} />
                    {m.goto && (
                      <text class="marker__count" y="4.5">
                        {m.count}
                      </text>
                    )}
                    <text
                      class="marker__label"
                      x={m.side === 'right' ? 18 : m.side === 'left' ? -18 : 0}
                      y={m.side === 'top' ? -18 : 6}
                    >
                      {m.label}
                    </text>
                  </g>
                ))}
              </g>
            </svg>
          ))
        }

        <div class="geo__controls" role="tablist" aria-label={t(locale, 'map.eyebrow')}>
          {
            sheets.map((sheet, i) => (
              <button type="button" role="tab" data-map-tab={sheet.id} aria-selected={i === 0 ? 'true' : 'false'}>
                {t(locale, sheet.labelKey)}
              </button>
            ))
          }
        </div>
      </div>

      <aside class="geo__aside" aria-live="polite">
        {
          sheets.map((sheet, i) => (
            <div class="geo__list" data-sheet-panel={sheet.id} hidden={i > 0}>
              <p class="t-eyebrow">
                {t(locale, sheet.labelKey)} · {countLabel(total(sheet))}
              </p>
              <ul>
                {sheet.groups.map((g) => (
                  <li>
                    <button type="button" class="geo__city-btn" data-city={cityId(g.city)}>
                      <span class="geo__city">{g.city}</span>
                      <span class="geo__sep" aria-hidden="true" />
                      <span class="t-meta">{countLabel(g.projects.length)}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        {
          sheets.flatMap((sheet) =>
            sheet.groups.map((g) => (
              <div class="city" data-city-panel={cityId(g.city)} data-sheet={sheet.id} hidden>
                <button type="button" class="city__back t-meta" data-city-back>
                  ← {t(locale, sheet.labelKey)}
                </button>
                <p class="t-eyebrow">
                  {g.city} · {g.country}
                </p>
                <ul>
                  {g.projects.map((p) => (
                    <li>
                      <a class="city__link" href={localePath(locale, `/projects/${slugOf(p)}`)}>
                        <span class="city__plate plate">
                          <Picture
                            formats={['avif']}
                            fallbackFormat="webp"
                            src={p.data.cover}
                            alt=""
                            widths={[160, 320]}
                            sizes="80px"
                            loading="lazy"
                          />
                        </span>
                        <span>
                          <span class="city__title">{p.data.title}</span>
                          <span class="t-meta">{typeLabel(p)}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )),
          )
        }

        {
          beyond.length > 0 && (
            <p class="geo__beyond t-meta">
              {t(locale, 'map.beyond')}: {beyond.map((g) => g.city).join(' · ')}
            </p>
          )
        }
      </aside>
    </div>
  </div>
</section>

<script>
  import '../../scripts/map';
</script>

<style>
  .geo__head {
    margin-bottom: var(--space-xl);
  }

  .geo__head .t-eyebrow {
    margin-bottom: var(--space-s);
  }

  .geo__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--space-xl);
    align-items: start;
  }

  .geo__figure {
    --map-h: clamp(340px, 54vh, 640px);
    width: 100%;
    max-width: calc(var(--map-h) * var(--map-ratio, 1.13));
    margin-inline: auto;
  }

  .geo__figure svg {
    display: block;
    width: 100%;
    height: var(--map-h);
  }

  .geo__figure svg[hidden] {
    display: none;
  }

  .geo__regions path {
    fill: var(--accent-line);
    fill-opacity: 0.22;
    stroke: var(--accent-line);
    stroke-opacity: 0.4;
    stroke-width: 0.5;
  }

  [data-map-sheet='riviera'] .geo__outline path {
    fill: var(--accent-line);
    fill-opacity: 0.1;
  }

  .geo__outline path {
    fill: none;
    stroke: var(--muted-inv);
    stroke-opacity: 0.5;
    stroke-width: 1.1;
    vector-effect: non-scaling-stroke;
  }

  .marker {
    cursor: pointer;
    outline: none;
  }

  .marker__hit {
    fill: #0000;
    pointer-events: all;
  }

  .marker__halo {
    fill: var(--accent-inv);
    fill-opacity: 0;
    transition: fill-opacity var(--dur) var(--ease);
  }

  .marker__dot {
    fill: var(--accent-inv);
    stroke: var(--ink-deep);
    stroke-width: 1.5;
  }

  .marker__count {
    fill: var(--ink-deep);
    font-family: var(--font-text);
    font-size: 11px;
    font-weight: 600;
    text-anchor: middle;
    pointer-events: none;
  }

  .marker__label {
    fill: var(--bone);
    font-family: var(--font-text);
    font-size: 19px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.75;
    transition: opacity var(--dur) var(--ease);
  }

  .marker--left .marker__label {
    text-anchor: end;
  }

  .marker--top .marker__label {
    text-anchor: middle;
  }

  .marker:hover .marker__halo,
  .marker:focus-visible .marker__halo,
  .marker.is-active .marker__halo {
    fill-opacity: 0.25;
  }

  .marker:hover .marker__label,
  .marker:focus-visible .marker__label,
  .marker.is-active .marker__label {
    opacity: 1;
  }

  @media (max-width: 700px) {
    .marker__label {
      font-size: 34px;
    }

    .marker__dot {
      r: 11;
    }

    .marker--goto .marker__dot {
      r: 16;
    }

    .marker__count {
      font-size: 16px;
    }

    .marker__hit {
      r: 50;
    }

    .marker__halo {
      r: 28;
    }
  }

  .geo__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-m);
  }

  .geo__controls button {
    padding: 0.5rem 0.875rem;
    background: transparent;
    color: inherit;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: var(--step-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .geo__controls button:hover,
  .geo__controls button[aria-selected='true'] {
    border-color: var(--accent-inv);
    color: var(--accent-inv);
  }

  .geo__aside {
    position: sticky;
    top: 6rem;
    min-height: 16rem;
  }

  .city ul,
  .geo__list ul {
    list-style: none;
    margin: var(--space-s) 0 0;
    padding: 0;
  }

  .geo__list li + li {
    margin-top: 0.125rem;
  }

  .geo__city-btn {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    width: 100%;
    padding: 0.375rem 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .geo__city-btn:hover .geo__city,
  .geo__city-btn:focus-visible .geo__city {
    color: var(--accent-inv);
  }

  .geo__sep {
    flex: 1;
    border-bottom: 1px dotted var(--rule);
  }

  .city__back {
    margin-bottom: var(--space-s);
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted-inv);
    cursor: pointer;
  }

  .city__back:hover {
    color: var(--accent-inv);
  }

  .city li + li {
    margin-top: var(--space-s);
  }

  .city__link {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-s);
    align-items: center;
  }

  .city__plate {
    aspect-ratio: var(--ratio-portrait);
  }

  .city__title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.125rem;
  }

  .geo__beyond {
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 901px) {
    .geo__figure {
      --map-h: clamp(420px, 62vh, 760px);
    }
  }

  @media (max-width: 900px) {
    .geo__body {
      grid-template-columns: 1fr;
    }

    .geo__aside {
      position: static;
      min-height: 0;
    }
  }
</style>
