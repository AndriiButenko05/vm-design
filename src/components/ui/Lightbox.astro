---
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  label: string;
}

const { locale, label } = Astro.props;
---

<dialog class="lb" data-lightbox aria-label={label}>
  <button type="button" class="lb__close" data-lightbox-close aria-label={t(locale, 'renders.close')}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5 L19 19 M19 5 L5 19" /></svg>
  </button>

  <button type="button" class="lb__nav lb__nav--prev" data-lightbox-prev aria-label={t(locale, 'renders.prev')}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 L7 12 L15 20" /></svg>
  </button>

  <div class="lb__stage" data-lightbox-stage>
    <picture>
      <source data-lightbox-avif type="image/avif" />
      <img data-lightbox-img alt="" />
    </picture>
  </div>

  <button type="button" class="lb__nav lb__nav--next" data-lightbox-next aria-label={t(locale, 'renders.nextImage')}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4 L17 12 L9 20" /></svg>
  </button>

  <p class="lb__counter t-meta" data-lightbox-counter></p>
</dialog>

<script>
  import '../../scripts/lightbox';
</script>

<style>
  .lb {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ink-deep);
    color: var(--bone);
  }

  .lb[open] {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: minmax(0, 1fr);
    align-items: stretch;
  }

  .lb {
    scrollbar-width: none;
  }

  .lb::-webkit-scrollbar {
    display: none;
  }

  .lb::backdrop {
    background: rgb(12 11 10 / 0.9);
  }

  .lb__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: clamp(1rem, 4vw, 3rem) clamp(1rem, 4vw, 3rem) clamp(3rem, 7vh, 4.5rem);
  }

  .lb__stage img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lb__nav,
  .lb__close {
    display: grid;
    place-items: center;
    align-self: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity var(--dur) var(--ease);
  }

  .lb__nav:hover,
  .lb__close:hover {
    opacity: 1;
  }

  .lb__nav svg,
  .lb__close svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }

  .lb__close {
    position: absolute;
    top: var(--space-s);
    right: var(--space-s);
    z-index: 2;
  }

  .lb__counter {
    position: absolute;
    left: 50%;
    bottom: var(--space-m);
    transform: translateX(-50%);
    margin: 0;
  }

  @media (max-width: 700px) {
    .lb[open] {
      grid-template-columns: minmax(0, 1fr);
    }

    .lb__nav {
      position: absolute;
      bottom: calc(var(--space-m) - 0.875rem);
      z-index: 2;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid rgb(244 241 236 / 0.25);
      border-radius: 999px;
      opacity: 1;
    }

    .lb__nav--prev {
      left: var(--space-m);
    }

    .lb__nav--next {
      right: var(--space-m);
    }

    .lb__stage {
      padding-bottom: 4.25rem;
    }
  }
</style>
