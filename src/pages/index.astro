---
import { Picture } from 'astro:assets';
import BaseLayout from '../components/layout/BaseLayout.astro';
import WorkBlock, { type RailItem } from '../components/work/WorkBlock.astro';
import Services from '../components/home/Services.astro';
import ContactSection from '../components/home/ContactSection.astro';
import Hero from '../components/home/Hero.astro';
import Materials from '../components/home/Materials.astro';
import GeographyMap from '../components/map/GeographyMap.astro';
import { getProjects, slugOf, type Project } from '../lib/projects';
import { ROOMS, coverOf, imageFor } from '../lib/renders';
import { resolveLocale, localePath, t } from '../lib/i18n';
import { SITE } from '../lib/site';
import portrait from '../assets/portrait.jpg';
/*
  Кадр першого екрана. Референс, який Марина приклала до фідбеку, — це
  та сама вітальня La Villa: сходи із золотим світильником, камін
  ліворуч, кухня з темним каменем праворуч.
*/
import heroImage from '../assets/projects/la-villa-nice/034-img-2560.jpg';

const locale = resolveLocale(Astro.currentLocale, Astro.url);
const projects = await getProjects(locale);

const byType = (type: Project['data']['type']) => projects.filter((p) => p.data.type === type);

/** Проєкт → елемент стрічки. */
const toItem = (p: Project): RailItem => ({
  href: `/projects/${slugOf(p)}`,
  title: p.data.title,
  meta: [p.data.city, p.data.year].filter(Boolean).join(' · '),
  image: p.data.cover,
  alt: p.data.coverAlt,
});

/** Розділ 3D → елемент стрічки. Той самий компонент, інші дані. */
const renderItems: RailItem[] = ROOMS.map((room) => {
  const cover = coverOf(room);
  return {
    href: `/visualisations/${room.slug}`,
    title: room.title,
    meta: `${room.count}`,
    image: imageFor(room.slug, cover.file),
    alt: `${room.title} — interior visualisation`,
  };
});

---

<BaseLayout
  title="VM Design — Maryna Vashchenko, architect & interior designer"
  description="Your life. Your character. Your interior. Residential and commercial interiors across the French Riviera, Monaco and Italy."
  transparentHeader
>
  {/*
    ТИМЧАСОВО: проба шрифтів на заголовках.

    Кожна секція головної отримує свою антикву й підпис із її назвою,
    щоб замовниця могла назвати конкретну, а не «оту, третю згори».
    Усі кандидати щільніші за Cormorant: скарга була саме на надто
    крихке й театральне накреслення.

    Cormorant лишається на першому й останньому екрані як точка
    відліку — щоб було з чим порівнювати.

    Прибрати разом із цими посиланнями, коли шрифт оберуть.
  */}
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Lora:wght@400&family=Libre+Baskerville:wght@400&family=Newsreader:wght@400&family=Source+Serif+4:wght@400&family=Crimson+Pro:wght@400&family=Literata:wght@400&family=EB+Garamond:wght@400&family=Spectral:wght@400&display=swap"
  />

  {/* ─── 1. Hero ─────────────────────────────────────────── */}
  <Hero locale={locale} image={heroImage} id="top" eager />

  {/* ─── 2. Коротко про студію ───────────────────────────── */}
  <section class="intro section" id="studio">
    <div class="container grid">
      <figure class="intro__portrait" data-reveal>
        <Picture
          formats={['avif']}
          fallbackFormat="webp"
          src={portrait}
          alt={SITE.designer}
          widths={[400, 800]}
          sizes="(max-width: 900px) 60vw, 28vw"
          loading="lazy"
        />
      </figure>

      <div class="intro__text" data-reveal style="--reveal-delay:120ms">
        <p class="t-eyebrow">{t(locale, 'about.eyebrow')}</p>
        <h2 class="t-h2">{t(locale, 'about.title')}</h2>
        <p class="t-lead">{t(locale, 'about.lead')}</p>
        <p>{t(locale, 'about.body')}</p>
        <p class="intro__more">
          <a class="link" href={localePath(locale, '/about')}>{t(locale, 'about.more')}</a>
        </p>
      </div>
    </div>
  </section>

  {/* ─── 3. Роботи: чотири блоки, сторони чергуються ─────── */}
  <WorkBlock
    locale={locale}
    index={1}
    {/*
      Якір projects, а не residential: із футера «Projects» веде сюди —
      у початок чотирьох стрічок робіт. На #residential не посилалося
      нічого, тож окремий порожній елемент-ціль тут зайвий.
    */}
    anchor={"projects"}
    titleKey="type.residential"
    textKey="type.residential.text"
    href="/projects/type/residential"
    items={byType('residential').map(toItem)}
  />

  <WorkBlock
    locale={locale}
    index={2}
    anchor={"commercial"}
    titleKey="type.commercial"
    textKey="type.commercial.text"
    href="/projects/type/commercial"
    items={byType('commercial').map(toItem)}
    reverse
  />

  <WorkBlock
    locale={locale}
    index={3}
    anchor={"exhibition"}
    titleKey="type.exhibition"
    textKey="type.exhibition.text"
    href="/projects/type/exhibition"
    items={byType('exhibition').map(toItem)}
  />

  <WorkBlock
    locale={locale}
    index={4}
    anchor={"renders"}
    titleKey="work.renders.title"
    textKey="work.renders.text"
    href="/visualisations"
    items={renderItems}
    reverse
  />

  {/*
    Блок Christina прибрано з головної.

    Замовниця: з 17 проєктів 11 мають brand: "Christina", і разом із
    окремою секцією тут сайт читався як портфоліо дизайнера одного
    косметичного бренду, а не студії житлової архітектури.

    Компонент components/home/Christina.astro лишається на місці, як і
    сторінка /christina, — попереду рішення, які один-два салони лишити
    окремими проєктами, а решту звести в кейс «Beauty Brand Spaces —
    Europe». Доти просто не рендеримо.
  */}

  {/* ─── 4. Services ─────────────────────────────────────── */}
  <Services locale={locale} id="services" />

  {/* ─── 5. Матеріали ────────────────────────────────────── */}
  <Materials locale={locale} projects={projects} id="materials" />

  {/* ─── 6. Карта ────────────────────────────────────────── */}
  <GeographyMap locale={locale} projects={projects} id="geography" />

  {/* ─── 7. Контакт ──────────────────────────────────────── */}
  <ContactSection locale={locale} id="contact" />
</BaseLayout>

<script>
  import '../scripts/swiper';
</script>

{/*
  ТИМЧАСОВО: проба шрифтів.

  is:global тому, що заголовки лежать у різних компонентах — Hero,
  WorkBlock, Services, Materials, GeographyMap, ContactSection.
  Локальні стилі сторінки туди не дістають.

  Перевизначаємо саму змінну --font-display на секції: вона успадковується,
  тож заголовок усередині переодягається без жодної правки в компонентах.
*/}
<style is:global>
  #studio { --font-display: 'Lora', Georgia, serif; }
  #projects { --font-display: 'Libre Baskerville', Georgia, serif; }
  #commercial { --font-display: 'Newsreader', Georgia, serif; }
  #exhibition { --font-display: 'Source Serif 4', Georgia, serif; }
  #renders { --font-display: 'Crimson Pro', Georgia, serif; }
  #services { --font-display: 'Literata', Georgia, serif; }
  #materials { --font-display: 'EB Garamond', Georgia, serif; }
  #geography { --font-display: 'Spectral', Georgia, serif; }

  /* Підпис над кожним заголовком — інакше не назвати, який саме сподобався. */
  #top h1::before,
  #studio h2::before,
  #projects h2::before,
  #commercial h2::before,
  #exhibition h2::before,
  #renders h2::before,
  #services h2::before,
  #materials h2::before,
  #geography h2::before,
  #contact h2::before {
    display: block;
    margin-bottom: 0.6rem;
    font-family: var(--font-text);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    /* currentColor, бо секції чергуються світлими й темними. */
    color: currentColor;
    opacity: 0.6;
  }

  #top h1::before { content: '1 · Cormorant Garamond — нинішній'; }
  #studio h2::before { content: '2 · Lora'; }
  #projects h2::before { content: '3 · Libre Baskerville'; }
  #commercial h2::before { content: '4 · Newsreader'; }
  #exhibition h2::before { content: '5 · Source Serif 4'; }
  #renders h2::before { content: '6 · Crimson Pro'; }
  #services h2::before { content: '7 · Literata'; }
  #materials h2::before { content: '8 · EB Garamond'; }
  #geography h2::before { content: '9 · Spectral'; }
  #contact h2::before { content: '10 · Cormorant Garamond — нинішній'; }
</style>

<style>
  /* Стилі першого екрана живуть у components/home/Hero.astro. */

  /* ─── Інтро ───────────────────────────────────────────── */

  .intro__portrait {
    grid-column: span 4;
    margin: 0;
  }

  .intro__portrait :global(img) {
    width: 100%;
    height: auto;
  }

  .intro__text {
    grid-column: 6 / span 7;
  }

  .intro__text .t-eyebrow {
    margin-bottom: var(--space-s);
  }

  .intro__text .t-h2 {
    margin-bottom: var(--space-l);
  }

  .intro__text p + p {
    margin-top: var(--space-m);
  }

  .intro__more {
    margin-top: var(--space-l);
  }

  @media (max-width: 900px) {
    /*
      Портрет — на всю ширину колонки, як і текст під ним.

      Тут стояло max-width: 18rem, і на телефоні виходило так: лівий
      край фото збігався з текстом, а правий не діставав до нього
      майже сотню пікселів. Виглядало як нерівне поле, хоч насправді
      відступи однакові — різнилася ширина самих блоків.
    */
    .intro__portrait {
      grid-column: 1 / -1;
    }

    .intro__text {
      grid-column: 1 / -1;
    }
  }

</style>
