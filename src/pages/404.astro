---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { resolveLocale, localePath, t } from '../lib/i18n';

const locale = resolveLocale(Astro.currentLocale, Astro.url);
---

<BaseLayout title="Not found — VM Design" description="This page does not exist.">
  <section class="nf on-ink-deep">
    <div class="container">
      <p class="t-eyebrow">404</p>
      <h1 class="t-display">Nothing here</h1>
      <p class="nf__links">
        <a class="link" href={localePath(locale, '/')}>Home</a>
        <a class="link" href={localePath(locale, '/projects')}>{t(locale, 'nav.work')}</a>
        <a class="link" href={localePath(locale, '/contact')}>{t(locale, 'nav.contact')}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .nf h1 {
    margin-block: var(--space-s) var(--space-xl);
  }

  .nf__links {
    display: flex;
    justify-content: center;
    gap: var(--space-l);
    max-width: none;
  }
</style>
