---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ProjectIndex from '../../components/project/ProjectIndex.astro';
import ProjectGrid from '../../components/project/ProjectGrid.astro';
import ProjectFilters from '../../components/project/ProjectFilters.astro';
import ContactSection from '../../components/home/ContactSection.astro';
import GeographyMap from '../../components/map/GeographyMap.astro';
import { getProjects, PROJECT_TYPES } from '../../lib/projects';
import { resolveLocale, t } from '../../lib/i18n';

const locale = resolveLocale(Astro.currentLocale, Astro.url);

// Спершу всі житлові, потім комерційні, потім виставки — усередині категорії
// порядок той самий, що на її сторінці. Сітка і список унизу йдуть однаково.
const all = await getProjects(locale);
const projects = PROJECT_TYPES.flatMap((type) => all.filter((p) => p.data.type === type));
---

<BaseLayout
  title={t(locale, 'meta.projects.title')}
  description={t(locale, 'meta.projects.description')}
>
  <section class="head section">
    <div class="container">
      <ProjectFilters locale={locale} current="all" />
      <p class="t-eyebrow">{t(locale, 'index.eyebrow')}</p>
      <h1 class="t-display">{t(locale, 'index.title')}</h1>
    </div>
  </section>

  <section class="group">
    <div class="container">
      <ProjectGrid locale={locale} projects={projects} eager={2} />
    </div>
  </section>

  <section class="group" aria-labelledby="group-all">
    <div class="container">
      <header class="group__head" data-reveal>
        <h2 class="t-subhead" id="group-all">{t(locale, 'index.all')}</h2>
      </header>
      <div data-reveal>
        <ProjectIndex locale={locale} projects={projects} />
      </div>
    </div>
  </section>

  <GeographyMap locale={locale} projects={projects} id="geography" />

  <ContactSection locale={locale} />
</BaseLayout>

<style>
  .head {
    padding-top: 7rem;
    padding-bottom: var(--space-xl);
  }

  .head .t-eyebrow {
    margin-bottom: var(--space-s);
  }

  .group {
    padding-bottom: var(--section);
  }

  .group__head {
    margin-bottom: var(--space-xl);
  }
</style>
