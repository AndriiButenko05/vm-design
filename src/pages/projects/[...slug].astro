---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Lightbox from '../../components/ui/Lightbox.astro';
import BeforeAfter from '../../components/project/BeforeAfter.astro';
import ProjectGallery from '../../components/project/ProjectGallery.astro';
import ProjectProcess from '../../components/project/ProjectProcess.astro';
import Drawings from '../../components/project/Drawings.astro';
import { setsForProject } from '../../lib/drawings';
import { byRoom } from '../../lib/rooms';
import { getProjects, localize, slugOf } from '../../lib/projects';
import { resolveLocale, t, DEFAULT_LOCALE, place, localePath } from '../../lib/i18n';
import { breadcrumbs, projectNode, projectTitle } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = await getProjects(DEFAULT_LOCALE);
  return projects.map((project) => ({
    params: { slug: slugOf(project) },
    props: { project },
  }));
}

const locale = resolveLocale(Astro.currentLocale, Astro.url);
const project = localize(Astro.props.project, locale);
const { Content } = await render(project);
const d = project.data;

const heroCandidates = [{ src: d.cover, alt: d.coverAlt }, ...d.gallery, ...d.renders];
const isWide = (c: { src: ImageMetadata }) => c.src.width > c.src.height;
const firstWide = heroCandidates.find(isWide);
const uniqueCandidates = [...new Map(heroCandidates.map((c) => [c.src, c])).values()];
const heroItems: { src: ImageMetadata; alt: string }[] = d.hero?.length
  ? d.hero
  : firstWide
    ? [firstWide]
    : uniqueCandidates.slice(0, 3);
const heroSrc = heroItems[0].src;
const gallery = byRoom(d.gallery, d.type, heroSrc);
const renders = byRoom(d.renders, d.type, heroSrc);

const heroIsRow = heroItems.length > 1;
const heroIsTall = !heroIsRow && !isWide(heroItems[0]);

const typeLabel = t(locale, `type.${d.type}`);
const where = `${place(locale, d.city)}, ${place(locale, d.country)}`;
const intro = [typeLabel, where, d.year ? String(d.year) : null].filter(Boolean).join(' · ');

const facts: { label: string; value: string | string[] }[] = [
  { label: t(locale, 'project.location'), value: where },
  { label: t(locale, 'project.brand'), value: d.brand ?? '' },
  { label: t(locale, 'project.year'), value: d.year ? String(d.year) : '' },
  { label: t(locale, 'project.area'), value: d.area ? `${d.area.toLocaleString(locale)} ${t(locale, 'project.m2')}` : '' },
  { label: t(locale, 'project.kind'), value: typeLabel },
  { label: t(locale, 'project.services'), value: d.scope },
].filter((f) => f.value.length > 0);

const pairs = d.beforeAfter?.pairs ?? [];

const slug = slugOf(project);
const drawingSets = setsForProject(slug);
const processImages = d.beforeAfter?.images ?? [];

const metaTitle = projectTitle(locale, {
  title: d.title,
  enTitle: Astro.props.project.data.title,
  type: d.type,
  city: d.city,
  year: d.year,
});
const metaDescription = d.type === 'exhibition' ? `${d.summary} ${t(locale, 'meta.stand.more')}` : d.summary;

const ogImage = heroItems[0].src;
const site = Astro.site!;
const jsonLd = [
  breadcrumbs(site, [
    { name: 'VM Design', path: localePath(locale, '/') },
    { name: t(locale, 'index.title'), path: localePath(locale, '/projects') },
    { name: typeLabel, path: localePath(locale, `/projects/type/${d.type}`) },
    { name: d.title, path: localePath(locale, `/projects/${slug}`) },
  ]),
  projectNode(site, locale, {
    slug,
    title: d.title,
    summary: d.summary,
    year: d.year,
    city: d.city,
    country: d.country,
    image: new URL((await getImage({ src: ogImage, width: 1600, format: 'jpg' })).src, site).href,
  }),
];
---

<BaseLayout title={metaTitle} description={metaDescription} ogImage={ogImage} jsonLd={jsonLd}>
  <link slot="head" rel="preload" href="/fonts/spectral-500-latin-normal.woff2" as="font" type="font/woff2" crossorigin />

  <article class="project">
    <header class="container page-intro">
      <p class="t-eyebrow">{intro}</p>
      <h1 class="page-intro__title">{d.title}</h1>
    </header>

    <figure class:list={['container hero', heroIsTall && 'hero--tall', heroIsRow && 'hero--row']}>
      {
        heroIsRow ? (
          <div class="hero__row">
            {heroItems.map((item, i) => (
              <div class="hero__cell" style={`--r:${(item.src.width / item.src.height).toFixed(4)}`}>
                <Picture
                  formats={['avif']}
                  fallbackFormat="webp"
                  src={item.src}
                  alt={item.alt}
                  widths={[500, 800, 1200]}
                  sizes="(max-width: 700px) 92vw, 34vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                />
              </div>
            ))}
          </div>
        ) : (
          <Picture
            formats={['avif']}
            fallbackFormat="webp"
            src={heroItems[0].src}
            alt={heroItems[0].alt}
            widths={[800, 1280, 1800, 2400]}
            sizes="(max-width: 1720px) 92vw, 1560px"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
      {d.heroCaption && <figcaption class="t-meta">{d.heroCaption}</figcaption>}
    </figure>

    <section class="section story-section">
      <div class="container grid story">
        <aside class="facts">
          <dl>
            {
              facts.map((f) => (
                <div class="facts__row">
                  <dt>{f.label}</dt>
                  <dd>
                    {Array.isArray(f.value)
                      ? f.value.map((v, i) => (
                          <>
                            {i > 0 && <br />}
                            {v}
                          </>
                        ))
                      : f.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </aside>

        <div class="prose" data-reveal>
          <p class="t-eyebrow prose__eyebrow">{t(locale, 'project.about')}</p>
          {project.bodyText ? project.bodyText.map((para) => <p>{para}</p>) : <Content />}
        </div>
      </div>
    </section>

    {pairs.length > 0 && <BeforeAfter locale={locale} pairs={pairs} />}

    {gallery.length > 0 && <ProjectGallery locale={locale} items={gallery} />}

    {
      renders.length > 0 && (
        <ProjectGallery
          locale={locale}
          items={renders}
          eyebrow={t(locale, 'renders3d.eyebrow')}
          title={t(locale, 'renders3d.title')}
          group="renders"
        />
      )
    }

    {drawingSets.length > 0 && <Drawings locale={locale} project={slug} title={d.title} sets={drawingSets} picks={d.drawingsPreview} />}

    {processImages.length > 0 && <ProjectProcess locale={locale} images={processImages} stage={d.processStage} />}

    <Lightbox locale={locale} label={d.title} />
  </article>
</BaseLayout>

<style>
  .hero {
    margin-block: 0;
  }

  .hero :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 82vh;
    object-fit: cover;
    background: var(--sand);
  }

  .hero--tall :global(picture) {
    display: flex;
    justify-content: center;
    background: var(--sand);
  }

  .hero--tall :global(img) {
    width: auto;
    max-width: 100%;
    height: min(82vh, 760px);
    object-fit: contain;
  }

  .hero__row {
    display: flex;
    gap: 0.5rem;
  }

  .hero__cell {
    flex: var(--r) 1 0;
    min-width: 0;
    aspect-ratio: var(--r);
    max-height: min(78vh, 720px);
  }

  .hero--row :global(picture) {
    display: contents;
  }

  .hero--row :global(img) {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
  }

  @media (max-width: 700px) {
    .hero__cell + .hero__cell {
      display: none;
    }

    /* Один кадр із ряду — на всю ширину, а не вузькою смугою зліва. */
    .hero__cell {
      flex: 1 1 100%;
      aspect-ratio: 4 / 5;
      max-height: none;
    }
  }

  .hero figcaption {
    padding-block: 0.625rem;
  }

  .story-section {
    padding-bottom: 0;
  }

  .story-section + :global(.section) {
    padding-top: var(--space-xl);
  }

  .story {
    align-items: start;
  }

  .facts {
    grid-column: span 4;
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }

  .facts dl {
    margin: 0;
  }

  .facts__row + .facts__row {
    margin-top: 1.75rem;
  }

  .facts dt {
    font-size: 0.875rem;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .facts dd {
    margin: 0.5rem 0 0;
    font-size: clamp(1.125rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.55;
  }

  .prose {
    grid-column: 6 / span 7;
    max-width: var(--measure);
  }

  .prose__eyebrow {
    margin-bottom: 0.75rem;
  }

  .prose :global(p:not(.prose__eyebrow)) {
    color: var(--fg-muted);
    font-size: clamp(1.125rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.65;
  }

  /*
    Лід і абзаци — однієї ширини: межу задає сама колонка (68ch основного
    кегля), а не кожен абзац окремо. Інакше лід крупним шрифтом зі своїм
    обмеженням у 30ch виходив удвічі вужчим за текст під ним.
  */
  .prose :global(p) {
    max-width: none;
  }

  .prose :global(.prose__eyebrow + p) {
    margin-block: 0 var(--space-m);
    font-family: var(--font-subhead);
    font-size: clamp(1.4375rem, 3.2vw, 2.0625rem);
    font-weight: 500;
    line-height: 1.27;
    color: var(--fg);
  }

  .prose :global(p + p) {
    margin-top: var(--space-s);
  }

  @media (max-width: 900px) {
    .facts,
    .prose {
      grid-column: 1 / -1;
    }

    .facts {
      margin-bottom: var(--space-l);
    }

    .story-section {
      padding-top: var(--space-s);
    }
  }
</style>
