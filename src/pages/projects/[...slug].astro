---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Lightbox from '../../components/ui/Lightbox.astro';
import BeforeAfter from '../../components/project/BeforeAfter.astro';
import ProjectGallery from '../../components/project/ProjectGallery.astro';
import ProjectProcess from '../../components/project/ProjectProcess.astro';
import { getProjects, slugOf } from '../../lib/projects';
import { resolveLocale, t, DEFAULT_LOCALE } from '../../lib/i18n';

/*
  Сторінка зібрана за макетом замовниці: титул, один широкий кадр,
  факти й опис, порівняння «до / після», галерея по кадру, процес.

  Креслення й «Наступний проєкт» у макеті немає — їх прибрано, поки
  замовниця не вирішить, чи повертати. Компоненти (project/Drawings.astro,
  lib/drawings.ts) лишаються в коді.
*/

export async function getStaticPaths() {
  const projects = await getProjects(DEFAULT_LOCALE);
  return projects.map((project) => ({
    params: { slug: slugOf(project) },
    props: { project },
  }));
}

const { project } = Astro.props;
const locale = resolveLocale(Astro.currentLocale, Astro.url);
const { Content } = await render(project);
const d = project.data;

/*
  Головний кадр — широкий, на всю ширину, як у макеті. Обкладинки
  здебільшого вертикальні (так їх зручно ставити в прев'ю), і на всю
  ширину такий кадр довелося б різати до смужки. Тому беремо перший
  горизонтальний кадр з обкладинки чи галереї, а якщо таких немає —
  обкладинку, вписану цілком у бежеве поле.
*/
const heroCandidates = [{ src: d.cover, alt: d.coverAlt }, ...d.gallery, ...d.renders];
const hero = heroCandidates.find((c) => c.src.width > c.src.height) ?? heroCandidates[0];
const heroIsWide = hero.src.width > hero.src.height;

const typeLabel = t(locale, `type.${d.type}`);
const intro = [typeLabel, `${d.city}, ${d.country}`, d.year ? String(d.year) : null].filter(Boolean).join(' · ');

/** Факти лівої колонки. Services — список, кожна послуга окремим рядком. */
const facts: { label: string; value: string | string[] }[] = [
  { label: t(locale, 'project.location'), value: `${d.city}, ${d.country}` },
  { label: t(locale, 'project.brand'), value: d.brand ?? '' },
  { label: t(locale, 'project.year'), value: d.year ? String(d.year) : '' },
  { label: t(locale, 'project.area'), value: d.area ? `${d.area} m²` : '' },
  { label: t(locale, 'project.kind'), value: typeLabel },
  { label: t(locale, 'project.services'), value: d.scope },
  { label: t(locale, 'project.materials'), value: d.materials },
].filter((f) => f.value.length > 0);

/*
  Кадри «до» працюють двічі. У порівнянні кожен стоїть у парі з готовим
  приміщенням і гортається по одному. У «Процесі» вони ж лежать сіткою
  під розгорткою: там весь стан будівництва видно одним поглядом.
  Розгортка закрита за замовчуванням, тож повтор не обтяжує сторінку.
*/
const pairs = d.beforeAfter?.pairs ?? [];
const processImages = d.beforeAfter?.images ?? [];
---

<BaseLayout title={`${d.title} — VM Design`} description={d.summary}>
  <link slot="head" rel="preload" href="/fonts/spectral-500-latin-normal.woff2" as="font" type="font/woff2" crossorigin />

  <article class="project">
    {/* ─── Титул ──────────────────────────────────────────── */}
    <header class="container intro">
      <p class="t-eyebrow">{intro}</p>
      <h1 class="intro__title">{d.title}</h1>
    </header>

    {/* ─── Головний кадр ──────────────────────────────────── */}
    <figure class:list={['container hero', !heroIsWide && 'hero--tall']}>
      <Picture
        formats={['avif']}
        fallbackFormat="webp"
        src={hero.src}
        alt={hero.alt}
        widths={[800, 1280, 1800, 2400]}
        sizes="(max-width: 1720px) 92vw, 1560px"
        loading="eager"
        fetchpriority="high"
      />
      {d.heroCaption && <figcaption class="t-meta">{d.heroCaption}</figcaption>}
    </figure>

    {/* ─── Факти + опис ───────────────────────────────────── */}
    <section class="section">
      <div class="container grid story">
        <aside class="facts">
          <dl>
            {
              facts.map((f) => (
                <div class="facts__row">
                  <dt>{f.label}</dt>
                  <dd>
                    {Array.isArray(f.value)
                      ? f.value.map((v, i) => (
                          <>
                            {i > 0 && <br />}
                            {v}
                          </>
                        ))
                      : f.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </aside>

        <div class="prose" data-reveal>
          <p class="t-eyebrow prose__eyebrow">{t(locale, 'project.about')}</p>
          <Content />
        </div>
      </div>
    </section>

    {/* ─── До / після ─────────────────────────────────────── */}
    {pairs.length > 0 && <BeforeAfter locale={locale} pairs={pairs} />}

    {/* ─── Галерея ────────────────────────────────────────── */}
    {d.gallery.length > 0 && <ProjectGallery locale={locale} items={d.gallery} />}

    {/* ─── 3D ─────────────────────────────────────────────── */}
    {
      d.renders.length > 0 && (
        <ProjectGallery
          locale={locale}
          items={d.renders}
          eyebrow={t(locale, 'renders3d.eyebrow')}
          title={t(locale, 'renders3d.title')}
          group="renders"
        />
      )
    }

    {/* ─── Процес ─────────────────────────────────────────── */}
    {processImages.length > 0 && <ProjectProcess locale={locale} images={processImages} />}

    <Lightbox locale={locale} label={d.title} />
  </article>
</BaseLayout>

<style>
  /* ─── Титул ────────────────────────────────────────────── */

  .intro {
    padding-top: clamp(7rem, 12vw, 9rem);
    padding-bottom: var(--space-m);
  }

  .intro .t-eyebrow {
    margin-bottom: 0.75rem;
  }

  .intro__title {
    font-family: var(--font-subhead);
    font-size: clamp(3.5rem, 9vw, 6.5rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  /* ─── Головний кадр ────────────────────────────────────── */

  .hero {
    margin-block: 0;
  }

  .hero :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 82vh;
    object-fit: cover;
    background: var(--sand);
  }

  /* Вертикальний кадр — цілком, у бежевому полі, без обрізання. */
  .hero--tall :global(picture) {
    display: flex;
    justify-content: center;
    background: var(--sand);
  }

  /* Висота — прямо на кадрі: відсоток від батька тут не резолвився б. */
  .hero--tall :global(img) {
    width: auto;
    max-width: 100%;
    height: min(82vh, 760px);
    object-fit: contain;
  }

  .hero figcaption {
    padding-block: 0.625rem;
  }

  /* ─── Факти ────────────────────────────────────────────── */

  .story {
    align-items: start;
  }

  .facts {
    grid-column: span 4;
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }

  .facts dl {
    margin: 0;
  }

  .facts__row + .facts__row {
    margin-top: 1.25rem;
  }

  .facts dt {
    font-size: var(--step-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .facts dd {
    margin: 0.25rem 0 0;
    font-size: var(--step-small);
  }

  /* ─── Опис ─────────────────────────────────────────────── */

  .prose {
    grid-column: 6 / span 7;
  }

  .prose__eyebrow {
    margin-bottom: 0.75rem;
  }

  /* Перший абзац — лід Spectral, як у макеті; решта — тихіша. */
  .prose :global(p:not(.prose__eyebrow)) {
    color: var(--fg-muted);
  }

  .prose :global(.prose__eyebrow + p) {
    max-width: 30ch;
    margin-block: 0 var(--space-m);
    font-family: var(--font-subhead);
    font-size: clamp(1.4375rem, 3.2vw, 2.0625rem);
    font-weight: 500;
    line-height: 1.27;
    color: var(--fg);
  }

  .prose :global(p + p) {
    margin-top: var(--space-s);
  }

  @media (max-width: 900px) {
    .facts,
    .prose {
      grid-column: 1 / -1;
    }

    .facts {
      margin-bottom: var(--space-l);
    }
  }
</style>
