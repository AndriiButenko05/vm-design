---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Lightbox from '../../components/ui/Lightbox.astro';
import BeforeAfter from '../../components/project/BeforeAfter.astro';
import ProjectGallery from '../../components/project/ProjectGallery.astro';
import ProjectProcess from '../../components/project/ProjectProcess.astro';
import Drawings from '../../components/project/Drawings.astro';
import { setsForProject } from '../../lib/drawings';
import { getProjects, slugOf } from '../../lib/projects';
import { resolveLocale, t, DEFAULT_LOCALE } from '../../lib/i18n';

/*
  Сторінка зібрана за макетом замовниці: титул, один широкий кадр,
  факти й опис, порівняння «до / після», галерея по кадру, процес.

  Креслення — після галереї: два-три аркуші й кнопка на весь комплект
  у PDF. «Наступного проєкту» в макеті немає, його прибрано.
*/

export async function getStaticPaths() {
  const projects = await getProjects(DEFAULT_LOCALE);
  return projects.map((project) => ({
    params: { slug: slugOf(project) },
    props: { project },
  }));
}

const { project } = Astro.props;
const locale = resolveLocale(Astro.currentLocale, Astro.url);
const { Content } = await render(project);
const d = project.data;

/*
  Головний кадр — великий, на всю ширину, як у макеті, і бажано головного
  приміщення. Порядок вибору:

  1. hero з frontmatter — кадри, обрані руками (найнадійніше: код не
     знає, де на фото вітальня, а де ванна);
  2. перший горизонтальний кадр з обкладинки, галереї чи 3D;
  3. якщо горизонтальних немає зовсім (проєкти, зняті на телефон) —
     перші три вертикальні в ряд. Один вертикальний кадр у бежевому полі
     займав би третину ширини й виглядав дрібно.
*/
const heroCandidates = [{ src: d.cover, alt: d.coverAlt }, ...d.gallery, ...d.renders];
const isWide = (c: { src: ImageMetadata }) => c.src.width > c.src.height;
const firstWide = heroCandidates.find(isWide);
const uniqueCandidates = [...new Map(heroCandidates.map((c) => [c.src.src, c])).values()];
const heroItems: { src: ImageMetadata; alt: string }[] = d.hero?.length
  ? d.hero
  : firstWide
    ? [firstWide]
    : uniqueCandidates.slice(0, 3);
const heroIsRow = heroItems.length > 1;
const heroIsTall = !heroIsRow && !isWide(heroItems[0]);

const typeLabel = t(locale, `type.${d.type}`);
const intro = [typeLabel, `${d.city}, ${d.country}`, d.year ? String(d.year) : null].filter(Boolean).join(' · ');

/** Факти лівої колонки. Services — список, кожна послуга окремим рядком. */
const facts: { label: string; value: string | string[] }[] = [
  { label: t(locale, 'project.location'), value: `${d.city}, ${d.country}` },
  { label: t(locale, 'project.brand'), value: d.brand ?? '' },
  { label: t(locale, 'project.year'), value: d.year ? String(d.year) : '' },
  { label: t(locale, 'project.area'), value: d.area ? `${d.area} m²` : '' },
  { label: t(locale, 'project.kind'), value: typeLabel },
  { label: t(locale, 'project.services'), value: d.scope },
  { label: t(locale, 'project.materials'), value: d.materials },
].filter((f) => f.value.length > 0);

/*
  Кадри «до» працюють двічі. У порівнянні кожен стоїть у парі з готовим
  приміщенням і гортається по одному. У «Процесі» вони ж лежать сіткою
  під розгорткою: там весь стан будівництва видно одним поглядом.
  Розгортка закрита за замовчуванням, тож повтор не обтяжує сторінку.
*/
const pairs = d.beforeAfter?.pairs ?? [];

const slug = slugOf(project);
const drawingSets = setsForProject(slug);
const processImages = d.beforeAfter?.images ?? [];
---

<BaseLayout title={`${d.title} — VM Design`} description={d.summary}>
  <link slot="head" rel="preload" href="/fonts/spectral-500-latin-normal.woff2" as="font" type="font/woff2" crossorigin />

  <article class="project">
    {/* ─── Титул ──────────────────────────────────────────── */}
    <header class="container page-intro">
      <p class="t-eyebrow">{intro}</p>
      <h1 class="page-intro__title">{d.title}</h1>
    </header>

    {/* ─── Головний кадр ──────────────────────────────────── */}
    <figure class:list={['container hero', heroIsTall && 'hero--tall', heroIsRow && 'hero--row']}>
      {
        heroIsRow ? (
          <div class="hero__row">
            {heroItems.map((item, i) => (
              <div class="hero__cell" style={`--r:${(item.src.width / item.src.height).toFixed(4)}`}>
                <Picture
                  formats={['avif']}
                  fallbackFormat="webp"
                  src={item.src}
                  alt={item.alt}
                  widths={[500, 800, 1200]}
                  sizes="(max-width: 700px) 92vw, 34vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                />
              </div>
            ))}
          </div>
        ) : (
          <Picture
            formats={['avif']}
            fallbackFormat="webp"
            src={heroItems[0].src}
            alt={heroItems[0].alt}
            widths={[800, 1280, 1800, 2400]}
            sizes="(max-width: 1720px) 92vw, 1560px"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
      {d.heroCaption && <figcaption class="t-meta">{d.heroCaption}</figcaption>}
    </figure>

    {/* ─── Факти + опис ───────────────────────────────────── */}
    <section class="section">
      <div class="container grid story">
        <aside class="facts">
          <dl>
            {
              facts.map((f) => (
                <div class="facts__row">
                  <dt>{f.label}</dt>
                  <dd>
                    {Array.isArray(f.value)
                      ? f.value.map((v, i) => (
                          <>
                            {i > 0 && <br />}
                            {v}
                          </>
                        ))
                      : f.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </aside>

        <div class="prose" data-reveal>
          <p class="t-eyebrow prose__eyebrow">{t(locale, 'project.about')}</p>
          <Content />
        </div>
      </div>
    </section>

    {/* ─── До / після ─────────────────────────────────────── */}
    {pairs.length > 0 && <BeforeAfter locale={locale} pairs={pairs} />}

    {/* ─── Галерея ────────────────────────────────────────── */}
    {d.gallery.length > 0 && <ProjectGallery locale={locale} items={d.gallery} />}

    {/* ─── 3D ─────────────────────────────────────────────── */}
    {
      d.renders.length > 0 && (
        <ProjectGallery
          locale={locale}
          items={d.renders}
          eyebrow={t(locale, 'renders3d.eyebrow')}
          title={t(locale, 'renders3d.title')}
          group="renders"
        />
      )
    }

    {/* ─── Креслення ──────────────────────────────────────── */}
    {drawingSets.length > 0 && <Drawings locale={locale} project={slug} sets={drawingSets} picks={d.drawingsPreview} />}

    {/* ─── Процес ─────────────────────────────────────────── */}
    {processImages.length > 0 && <ProjectProcess locale={locale} images={processImages} />}

    <Lightbox locale={locale} label={d.title} />
  </article>
</BaseLayout>

<style>
  /* ─── Головний кадр ────────────────────────────────────── */

  .hero {
    margin-block: 0;
  }

  .hero :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 82vh;
    object-fit: cover;
    background: var(--sand);
  }

  /* Вертикальний кадр — цілком, у бежевому полі, без обрізання. */
  .hero--tall :global(picture) {
    display: flex;
    justify-content: center;
    background: var(--sand);
  }

  /* Висота — прямо на кадрі: відсоток від батька тут не резолвився б. */
  .hero--tall :global(img) {
    width: auto;
    max-width: 100%;
    height: min(82vh, 760px);
    object-fit: contain;
  }

  /*
    Два-три вертикальні кадри в ряд. Ширина комірки пропорційна
    співвідношенню сторін кадру (flex-grow = w/h), тож усі кадри виходять
    однієї висоти й разом заповнюють ширину без обрізання.
  */
  .hero__row {
    display: flex;
    gap: 0.5rem;
  }

  /*
    Кадри з телефона бувають 9:16 — у повну висоту ряд не влазив би
    в перший екран. Висота обмежена, кадр заповнює комірку (cover) і
    втрачає лише трохи згори й знизу.
  */
  .hero__cell {
    flex: var(--r) 1 0;
    min-width: 0;
    aspect-ratio: var(--r);
    max-height: min(78vh, 720px);
  }

  .hero--row :global(picture) {
    display: contents;
  }

  .hero--row :global(img) {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
  }

  /* На телефоні ряд з трьох вийшов би дрібним — лишаємо перший кадр. */
  @media (max-width: 700px) {
    .hero__cell + .hero__cell {
      display: none;
    }
  }

  .hero figcaption {
    padding-block: 0.625rem;
  }

  /* ─── Факти ────────────────────────────────────────────── */

  .story {
    align-items: start;
  }

  .facts {
    grid-column: span 4;
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }

  .facts dl {
    margin: 0;
  }

  .facts__row + .facts__row {
    margin-top: 1.25rem;
  }

  .facts dt {
    font-size: var(--step-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .facts dd {
    margin: 0.25rem 0 0;
    font-size: var(--step-small);
  }

  /* ─── Опис ─────────────────────────────────────────────── */

  .prose {
    grid-column: 6 / span 7;
  }

  .prose__eyebrow {
    margin-bottom: 0.75rem;
  }

  /* Перший абзац — лід Spectral, як у макеті; решта — тихіша. */
  .prose :global(p:not(.prose__eyebrow)) {
    color: var(--fg-muted);
  }

  .prose :global(.prose__eyebrow + p) {
    max-width: 30ch;
    margin-block: 0 var(--space-m);
    font-family: var(--font-subhead);
    font-size: clamp(1.4375rem, 3.2vw, 2.0625rem);
    font-weight: 500;
    line-height: 1.27;
    color: var(--fg);
  }

  .prose :global(p + p) {
    margin-top: var(--space-s);
  }

  @media (max-width: 900px) {
    .facts,
    .prose {
      grid-column: 1 / -1;
    }

    .facts {
      margin-bottom: var(--space-l);
    }
  }
</style>
