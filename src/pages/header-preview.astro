---
/**
 * Тимчасова сторінка: три варіанти шапки над фото на головній, щоб Марина вибрала.
 * Не в меню, не в sitemap, noindex. Після вибору — видалити разом із ?hv= у BaseLayout і Header.
 */
import BaseLayout from '../components/layout/BaseLayout.astro';

const variants = [
  {
    key: 't-bone',
    name: 'A. Прозора → світла (колір як зараз)',
    text: 'Над фото шапки не видно — білий логотип і меню прямо на фото. Після прокрутки — світла шапка, як зараз на сайті.',
  },
  {
    key: 't-dark',
    name: 'B. Прозора → темна (колір як було спочатку)',
    text: 'Над фото прозора. Після прокрутки — темна шапка з білим текстом, як була на самому початку.',
  },
  {
    key: 't-sand',
    name: 'C. Прозора → пісочна',
    text: 'Над фото прозора. Після прокрутки — тепла пісочна шапка, трохи темніша за фон сторінки, з темним текстом.',
  },
  {
    key: 't-slate',
    name: 'D. Прозора → сіро-коричнева',
    text: 'Над фото прозора. Після прокрутки — приглушена сіро-коричнева шапка зі світлим текстом.',
  },
  {
    key: 't-bronze',
    name: 'E. Прозора → бронзова',
    text: 'Над фото прозора. Після прокрутки — шапка в бронзовому акцентному кольорі сайту зі світлим текстом.',
  },
];
---

<BaseLayout title="Варіанти шапки — VM Design" description="Порівняння варіантів шапки сайту." noindex>
  <section class="hp section">
    <div class="container">
      <h1 class="t-h1">Варіанти шапки</h1>
      <p class="hp__lead">
        У всіх варіантах шапка прозора над великим фото вгорі (головна, Christina), а після прокрутки отримує колір.
        Цей самий колір — у шапки й на всіх інших сторінках (проєкти, послуги, контакти). У кожній рамці можна
        <strong>прокрутити сторінку вниз</strong>, щоб побачити, як шапка змінюється. Ліворуч — компʼютер, праворуч —
        телефон; посилання під рамкою відкриває варіант на весь екран, і по ньому можна ходити сайтом.
      </p>

      {
        variants.map((v) => (
          <article class="hp__variant">
            <h2 class="t-h3">{v.name}</h2>
            <p class="hp__text">{v.text}</p>
            <div class="hp__frames">
              <div class="hp__desktop">
                <iframe src={`/?hv=${v.key}`} title={`${v.name} — компʼютер`} loading="lazy" />
              </div>
              <div class="hp__mobile">
                <iframe src={`/?hv=${v.key}`} title={`${v.name} — телефон`} loading="lazy" />
              </div>
            </div>
            <p class="hp__open">
              <a class="link" href={`/?hv=${v.key}`} target="_blank" rel="noopener">
                Відкрити на весь екран ↗
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Зменшує сторінку 1440 px під ширину рамки.
  const fit = (box: HTMLElement) => box.style.setProperty('--k', String(box.clientWidth / 1440));
  const ro = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target as HTMLElement)));
  document.querySelectorAll<HTMLElement>('.hp__desktop').forEach((box) => {
    fit(box);
    ro.observe(box);
  });
</script>

<style>
  .hp {
    padding-top: 7rem;
  }

  .hp__lead {
    margin-top: var(--space-m);
    max-width: 70ch;
  }

  .hp__variant {
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--rule);
  }

  .hp__text {
    margin-top: var(--space-xs);
    color: var(--fg-muted);
  }

  .hp__frames {
    display: flex;
    gap: var(--space-l);
    align-items: flex-start;
    margin-top: var(--space-m);
  }

  /* Компʼютер: сторінка 1440×900, зменшена під ширину рамки. */
  .hp__desktop {
    flex: 1 1 auto;
    min-width: 0;
    aspect-ratio: 1440 / 900;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--ink-deep);
  }

  .hp__desktop iframe {
    width: 1440px;
    height: 900px;
    border: 0;
    transform: scale(var(--k, 0.5));
    transform-origin: 0 0;
  }

  .hp__mobile {
    flex: 0 0 auto;
    width: 300px;
    height: 649px;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 18px;
    background: var(--ink-deep);
  }

  .hp__mobile iframe {
    width: 390px;
    height: 844px;
    border: 0;
    transform: scale(calc(300 / 390));
    transform-origin: 0 0;
  }

  .hp__open {
    margin-top: var(--space-s);
  }

  @media (max-width: 900px) {
    .hp__frames {
      flex-direction: column;
    }

    .hp__desktop {
      width: 100%;
    }
  }
</style>
