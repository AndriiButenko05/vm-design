---
/**
 * Тимчасова сторінка: три варіанти шапки над фото на головній, щоб Марина вибрала.
 * Не в меню, не в sitemap, noindex. Після вибору — видалити разом із ?hv= у BaseLayout і Header.
 */
import BaseLayout from '../components/layout/BaseLayout.astro';

const variants = [
  {
    key: 'dark',
    name: 'A. Як було спочатку',
    text: 'Над фото — темна смуга, логотип і меню білі. Після прокрутки шапка стає світлою.',
  },
  {
    key: 'clear',
    name: 'B. Прозора',
    text: 'Над фото шапки не видно — білий логотип і меню прямо на фото. Після прокрутки зʼявляється світлий фон.',
  },
  {
    key: 'current',
    name: 'C. Як зараз',
    text: 'Над фото — світла напівпрозора смуга з розмиттям, темний логотип і меню. Після прокрутки — суцільна світла.',
  },
];
---

<BaseLayout title="Варіанти шапки — VM Design" description="Порівняння варіантів шапки сайту." noindex>
  <section class="hp section">
    <div class="container">
      <h1 class="t-h1">Варіанти шапки</h1>
      <p class="hp__lead">
        Шапка відрізняється лише на сторінках із великим фото вгорі — на головній і Christina; на решті сторінок
        вона завжди світла. У кожній рамці можна <strong>прокрутити сторінку вниз</strong>, щоб побачити, як шапка
        змінюється після скролу. Ліворуч — компʼютер, праворуч — телефон.
      </p>

      {
        variants.map((v) => (
          <article class="hp__variant">
            <h2 class="t-h3">{v.name}</h2>
            <p class="hp__text">{v.text}</p>
            <div class="hp__frames">
              <div class="hp__desktop">
                <iframe src={v.key === 'current' ? '/' : `/?hv=${v.key}`} title={`${v.name} — компʼютер`} loading="lazy" />
              </div>
              <div class="hp__mobile">
                <iframe src={v.key === 'current' ? '/' : `/?hv=${v.key}`} title={`${v.name} — телефон`} loading="lazy" />
              </div>
            </div>
            <p class="hp__open">
              <a class="link" href={v.key === 'current' ? '/' : `/?hv=${v.key}`} target="_blank" rel="noopener">
                Відкрити на весь екран ↗
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Зменшує сторінку 1440 px під ширину рамки.
  const fit = (box: HTMLElement) => box.style.setProperty('--k', String(box.clientWidth / 1440));
  const ro = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target as HTMLElement)));
  document.querySelectorAll<HTMLElement>('.hp__desktop').forEach((box) => {
    fit(box);
    ro.observe(box);
  });
</script>

<style>
  .hp {
    padding-top: 7rem;
  }

  .hp__lead {
    margin-top: var(--space-m);
    max-width: 70ch;
  }

  .hp__variant {
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--rule);
  }

  .hp__text {
    margin-top: var(--space-xs);
    color: var(--fg-muted);
  }

  .hp__frames {
    display: flex;
    gap: var(--space-l);
    align-items: flex-start;
    margin-top: var(--space-m);
  }

  /* Компʼютер: сторінка 1440×900, зменшена під ширину рамки. */
  .hp__desktop {
    flex: 1 1 auto;
    min-width: 0;
    aspect-ratio: 1440 / 900;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--ink-deep);
  }

  .hp__desktop iframe {
    width: 1440px;
    height: 900px;
    border: 0;
    transform: scale(var(--k, 0.5));
    transform-origin: 0 0;
  }

  .hp__mobile {
    flex: 0 0 auto;
    width: 300px;
    height: 649px;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 18px;
    background: var(--ink-deep);
  }

  .hp__mobile iframe {
    width: 390px;
    height: 844px;
    border: 0;
    transform: scale(calc(300 / 390));
    transform-origin: 0 0;
  }

  .hp__open {
    margin-top: var(--space-s);
  }

  @media (max-width: 900px) {
    .hp__frames {
      flex-direction: column;
    }

    .hp__desktop {
      width: 100%;
    }
  }
</style>
