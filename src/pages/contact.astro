---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ContactSection from '../components/home/ContactSection.astro';
import { resolveLocale } from '../lib/i18n';

const locale = resolveLocale(Astro.currentLocale, Astro.url);
---

<BaseLayout
  title="Contact — VM Design"
  description="Start a project with Maryna Vashchenko. Interiors across the French Riviera, Monaco and Italy."
>
  <div class="pad">
    <ContactSection locale={locale} as="h1" />
  </div>
</BaseLayout>

<style>
  .pad {
    padding-top: 4rem;
  }
</style>
