---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ContactSection from '../components/home/ContactSection.astro';
import { resolveLocale, t } from '../lib/i18n';

const locale = resolveLocale(Astro.currentLocale, Astro.url);
---

<BaseLayout
  title={t(locale, 'meta.contact.title')}
  description={t(locale, 'meta.contact.description')}
>
  <div class="pad">
    <ContactSection locale={locale} as="h1" />
  </div>
</BaseLayout>

<style>
  .pad {
    padding-top: 4rem;
  }
</style>
