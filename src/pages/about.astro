---
import { Picture } from 'astro:assets';
import BaseLayout from '../components/layout/BaseLayout.astro';
import ContactSection from '../components/home/ContactSection.astro';
import GeographyMap from '../components/map/GeographyMap.astro';
import { getProjects } from '../lib/projects';
import { resolveLocale, t, place } from '../lib/i18n';
import { SITE } from '../lib/site';
import portrait from '../assets/portrait.jpg';
import portraitOg from '../assets/og/about-portrait.jpg';

const locale = resolveLocale(Astro.currentLocale, Astro.url);
const projects = await getProjects(locale);

const BIO = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => t(locale, `about.bio.${n}`));

const PROCESS = [1, 2, 3, 4].map((n) => ({
  n: String(n).padStart(2, '0'),
  title: t(locale, `about.process.${n}.title`),
  text: t(locale, `about.process.${n}.text`),
}));

const list = (items: readonly string[]) => items.map((x) => place(locale, x)).join(' · ');
---

<BaseLayout
  title={t(locale, 'meta.about.title')}
  description={t(locale, 'meta.about.description')}
  ogImage={portraitOg}
>
  <section class="lede section">
    <div class="container grid">
      <div class="lede__type">
        <p class="t-eyebrow">{t(locale, 'nav.about')}</p>
        <h1 class="t-display">{t(locale, 'about.name.first')}<br />{t(locale, 'about.name.last')}</h1>
        <p class="t-meta lede__role">{t(locale, 'site.role')}</p>

        <blockquote class="lede__quote">
          <p>{t(locale, 'about.quote')}</p>
        </blockquote>
      </div>

      <figure class="lede__portrait">
        <Picture
          src={portrait}
          formats={['avif']}
          fallbackFormat="webp"
          alt={t(locale, 'meta.designer')}
          widths={[500, 1000]}
          sizes="(max-width: 900px) 70vw, 34vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="bio section">
    <div class="container grid">
      <aside class="bio__facts">
        <dl>
          <div>
            <dt class="t-meta">{t(locale, 'about.fact.experience')}</dt>
            <dd>{t(locale, 'about.fact.experienceValue', { n: SITE.facts.experienceYears })}</dd>
          </div>
          <div>
            <dt class="t-meta">{t(locale, 'about.fact.based')}</dt>
            <dd>{place(locale, SITE.facts.based)}</dd>
          </div>
          <div>
            <dt class="t-meta">{t(locale, 'about.fact.across')}</dt>
            <dd>{list(SITE.regions)}</dd>
          </div>
          <div>
            <dt class="t-meta">{t(locale, 'about.fact.international')}</dt>
            <dd>{list(SITE.facts.internationalExperience)}</dd>
          </div>
          <div>
            <dt class="t-meta">{t(locale, 'about.fact.languages')}</dt>
            <dd>{list(SITE.facts.languages)}</dd>
          </div>
        </dl>
      </aside>

      <div class="bio__text" data-reveal>
        {BIO.map((para, i) => <p class:list={[i === 0 && 't-lead']}>{para}</p>)}
      </div>
    </div>
  </section>

  <section class="process on-sand section">
    <div class="container">
      <header class="process__head" data-reveal>
        <p class="t-eyebrow">{t(locale, 'about.process.eyebrow')}</p>
        <h2 class="t-h2">{t(locale, 'about.process.title')}</h2>
      </header>

      <ol class="process__list">
        {
          PROCESS.map((step, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="t-meta">{step.n}</span>
              <h3 class="process__title">{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <GeographyMap locale={locale} projects={projects} />
  <ContactSection locale={locale} />
</BaseLayout>

<style>
  .lede {
    padding-top: 7rem;
  }

  .lede__type {
    grid-column: span 6;
  }

  .lede__type h1 {
    margin-block: var(--space-m) var(--space-s);
    font-size: clamp(2.75rem, 6.4vw, 7rem);
  }

  .lede__role {
    margin-bottom: var(--space-xl);
  }

  .lede__quote {
    margin: 0;
    padding-inline-start: var(--space-m);
    border-inline-start: 1px solid var(--accent-line);
  }

  .lede__quote p {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.875rem);
    line-height: 1.3;
  }

  .lede__portrait {
    grid-column: 8 / span 5;
    margin: 0;
  }

  .lede__portrait :global(img) {
    width: 100%;
    height: auto;
  }

  .bio__facts {
    grid-column: span 4;
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .bio__facts dl {
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .bio__facts > dl > div {
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--rule);
  }

  .bio__facts dd {
    margin: 0.25rem 0 0;
  }

  .bio__text {
    grid-column: 6 / span 7;
  }

  .bio__text p + p {
    margin-top: var(--space-m);
  }

  .process__head {
    margin-bottom: var(--space-xl);
  }

  .process__head .t-eyebrow {
    margin-bottom: var(--space-s);
  }

  .process__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process__list li {
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  .process__title {
    margin-block: var(--space-xs) var(--space-s);
    font-family: var(--font-display);
    font-size: 1.375rem;
  }

  @media (max-width: 900px) {
    .lede__type,
    .lede__portrait,
    .bio__facts,
    .bio__text {
      grid-column: 1 / -1;
    }

    .lede__portrait {
      order: -1;
    }

    .bio__facts {
      position: static;
      margin-bottom: var(--space-xl);
    }

    .process__list {
      grid-template-columns: 1fr;
    }
  }
</style>
