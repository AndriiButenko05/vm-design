---
import { Picture } from 'astro:assets';
import BaseLayout from '../components/layout/BaseLayout.astro';
import HeroSlider from '../components/home/HeroSlider.astro';
import ContactSection from '../components/home/ContactSection.astro';
import { getProjects, slugOf, type Project } from '../lib/projects';
import { resolveLocale, localePath, t, place } from '../lib/i18n';

const locale = resolveLocale(Astro.currentLocale, Astro.url);
const all = await getProjects(locale);

const christina = all.filter((p) => p.data.brand === 'Christina');
const retail = christina.filter((p) => p.data.type === 'commercial');
const stands = christina.filter((p) => p.data.type === 'exhibition');

const countries = [...new Set(christina.map((p) => p.data.country))];
const years = christina.map((p) => p.data.year).filter(Boolean) as number[];
const span = years.length ? `${Math.min(...years)} — ${Math.max(...years)}` : null;

const cover = retail.find((p) => slugOf(p) === 'christina-roma') ?? retail[0];

const heroSlides = [cover, ...retail.filter((p) => p !== cover)].filter(Boolean).map((p) => ({
  src: p.data.cover,
  alt: p.data.coverAlt,
  href: localePath(locale, `/projects/${slugOf(p)}`),
  label: [place(locale, p.data.city), p.data.year].filter(Boolean).join(' · '),
}));

const card = (p: Project) => ({
  href: localePath(locale, `/projects/${slugOf(p)}`),
  title: p.data.title,
  meta: [place(locale, p.data.city), p.data.year].filter(Boolean).join(' · '),
});
---

<BaseLayout
  title={t(locale, 'meta.christina.title')}
  description={t(locale, 'meta.christina.description')}
  ogImage={cover?.data.cover}
  transparentHeader
>
  <article>
    <header class="lede on-ink-deep">
      <div class="container lede__inner">
        <div class="lede__type">
          <p class="t-eyebrow">{t(locale, 'christina.eyebrow')}</p>
          <h1 class="t-display">Christina</h1>
          <p class="t-lead">{t(locale, 'christina.text')}</p>
        </div>

        {
          heroSlides.length > 0 && (
            <div class="lede__plate">
              <HeroSlider slides={heroSlides} label="Christina" />
            </div>
          )
        }
      </div>
    </header>

    <section class="facts on-ink">
      <dl class="container facts__grid">
        <div>
          <dt class="t-meta">{t(locale, 'christina.facts.retail')}</dt>
          <dd class="facts__n">{retail.length}</dd>
        </div>
        <div>
          <dt class="t-meta">{t(locale, 'christina.facts.stands')}</dt>
          <dd class="facts__n">{stands.length}</dd>
        </div>
        <div>
          <dt class="t-meta">{t(locale, 'christina.facts.countries')}</dt>
          <dd class="facts__n">{countries.length}</dd>
        </div>
        {
          span && (
            <div>
              <dt class="t-meta">{t(locale, 'christina.facts.years')}</dt>
              <dd class="facts__n facts__n--small">{span}</dd>
            </div>
          )
        }
      </dl>
    </section>

    <section class="stream section">
      <div class="container">
        <header class="stream__head" data-reveal>
          <p class="t-eyebrow">{t(locale, 'christina.retail.eyebrow')}</p>
          <h2 class="t-h2">{t(locale, 'christina.retail.title')}</h2>
          <p class="stream__text">{t(locale, 'christina.retail.text')}</p>
        </header>

        <ul class="stream__grid">
          {
            retail.map((p, i) => {
              const c = card(p);
              return (
                <li data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
                  <a href={c.href}>
                    <span class="plate plate--tall">
                      <Picture
                        formats={['avif']}
                        fallbackFormat="webp"
                        src={p.data.cover}
                        alt={p.data.coverAlt}
                        widths={[400, 800, 1200]}
                        sizes="(max-width: 700px) 92vw, 30vw"
                        loading="lazy"
                      />
                    </span>
                    <span class="stream__caption">
                      <span class="stream__title">{c.title}</span>
                      <span class="t-meta">{c.meta}</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <section class="stream stream--stands on-sand section">
      <div class="container">
        <header class="stream__head" data-reveal>
          <p class="t-eyebrow">{t(locale, 'christina.stands.eyebrow')}</p>
          <h2 class="t-h2">{t(locale, 'christina.stands.title')}</h2>
          <p class="stream__text">{t(locale, 'christina.stands.text')}</p>
        </header>

        <ul class="stream__grid stream__grid--wide">
          {
            stands.map((p, i) => {
              const c = card(p);
              return (
                <li data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
                  <a href={c.href}>
                    <span class="plate plate--portrait">
                      <Picture
                        formats={['avif']}
                        fallbackFormat="webp"
                        src={p.data.cover}
                        alt={p.data.coverAlt}
                        widths={[360, 720]}
                        sizes="(max-width: 700px) 46vw, 22vw"
                        loading="lazy"
                      />
                    </span>
                    <span class="stream__caption">
                      <span class="stream__title">{c.title}</span>
                      <span class="t-meta">{place(locale, p.data.city)}</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>
  </article>

  <ContactSection locale={locale} />
</BaseLayout>

<style>
  .lede {
    padding-block: 7rem var(--space-2xl);
  }

  .lede__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .lede h1 {
    margin-block: var(--space-m) var(--space-l);
  }


  .facts {
    padding-block: var(--space-2xl);
  }

  .facts__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-l);
    margin-block: 0;
  }

  .facts__n {
    margin: var(--space-xs) 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    color: var(--accent-inv);
  }

  .facts__n--small {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .stream__head {
    margin-bottom: var(--space-xl);
  }

  .stream__head .t-eyebrow {
    margin-bottom: var(--space-s);
  }

  .stream__text {
    margin-top: var(--space-m);
    max-width: 58ch;
    color: var(--fg-muted);
  }

  .stream__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stream__grid--wide {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .stream__caption {
    display: block;
    margin-top: var(--space-s);
  }

  .stream__title {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
  }

  @media (max-width: 900px) {
    .lede__inner {
      grid-template-columns: 1fr;
    }

    .lede__plate {
      width: 100%;
    }

    .facts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stream__grid,
    .stream__grid--wide {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
