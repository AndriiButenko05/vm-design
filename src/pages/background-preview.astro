---
/**
 * Тимчасова сторінка: три варіанти фону сайту, щоб Марина подивилась.
 * Не в меню, не в sitemap, noindex. Після вибору — видалити разом із ?bg= у BaseLayout і блоком у tokens.css.
 */
import BaseLayout from '../components/layout/BaseLayout.astro';

const variants = [
  {
    key: 'none',
    name: 'A. Як зараз',
    text: 'Світлий теплий фон (молочний), темний текст.',
  },
  {
    key: 'darker',
    name: 'B. Темніше',
    text: 'Той самий теплий відтінок, але на тон темніший — ближче до пісочного. Шапка й світлі блоки теж трохи темніші.',
  },
  {
    key: 'dark',
    name: 'C. Темний',
    text: 'Темний графітовий фон зі світлим текстом — сайт повністю в темних тонах.',
  },
];
---

<BaseLayout title="Варіанти фону — VM Design" description="Порівняння варіантів фону сайту." noindex>
  <section class="hp section">
    <div class="container">
      <h1 class="t-h1">Варіанти фону сайту</h1>
      <p class="hp__lead">
        Змінюється фон усіх світлих частин сайту. Темні блоки — перший екран із фото, контакти, мапа, футер — лишаються
        як є. Ліворуч — сторінка проєктів на компʼютері, праворуч — «Про студію» на телефоні; у рамках можна
        прокручувати. Посилання під рамкою відкриває варіант на весь екран, і по ньому можна ходити всім сайтом.
      </p>

      {
        variants.map((v) => (
          <article class="hp__variant">
            <h2 class="t-h3">{v.name}</h2>
            <p class="hp__text">{v.text}</p>
            <div class="hp__frames">
              <div class="hp__desktop">
                <iframe src={`/projects/?bg=${v.key}`} title={`${v.name} — компʼютер`} loading="lazy" />
              </div>
              <div class="hp__mobile">
                <iframe src={`/about/?bg=${v.key}`} title={`${v.name} — телефон`} loading="lazy" />
              </div>
            </div>
            <p class="hp__open">
              <a class="link" href={`/?bg=${v.key}`} target="_blank" rel="noopener">
                Відкрити на весь екран ↗
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Зменшує сторінку 1440 px під ширину рамки.
  const fit = (box: HTMLElement) => box.style.setProperty('--k', String(box.clientWidth / 1440));
  const ro = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target as HTMLElement)));
  document.querySelectorAll<HTMLElement>('.hp__desktop').forEach((box) => {
    fit(box);
    ro.observe(box);
  });
</script>

<style>
  .hp {
    padding-top: 7rem;
  }

  .hp__lead {
    margin-top: var(--space-m);
    max-width: 70ch;
  }

  .hp__variant {
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--rule);
  }

  .hp__text {
    margin-top: var(--space-xs);
    color: var(--fg-muted);
  }

  .hp__frames {
    display: flex;
    gap: var(--space-l);
    align-items: flex-start;
    margin-top: var(--space-m);
  }

  .hp__desktop {
    flex: 1 1 auto;
    min-width: 0;
    aspect-ratio: 1440 / 900;
    overflow: hidden;
    border: 1px solid var(--rule);
  }

  .hp__desktop iframe {
    width: 1440px;
    height: 900px;
    border: 0;
    transform: scale(var(--k, 0.5));
    transform-origin: 0 0;
  }

  .hp__mobile {
    flex: 0 0 auto;
    width: 300px;
    height: 649px;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 18px;
  }

  .hp__mobile iframe {
    width: 390px;
    height: 844px;
    border: 0;
    transform: scale(calc(300 / 390));
    transform-origin: 0 0;
  }

  .hp__open {
    margin-top: var(--space-s);
  }

  @media (max-width: 900px) {
    .hp__frames {
      flex-direction: column;
    }

    .hp__desktop {
      width: 100%;
    }
  }
</style>
