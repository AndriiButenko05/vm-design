{
  // Конфігурація Cloudflare Pages.
  //
  // Сайт статичний: адаптера Astro немає, збірка — просто тека файлів.
  // Тому тут немає ні "main", ні коду воркера: Cloudflare віддає вміст
  // ./dist напряму зі своєї мережі, нічого не виконуючи на запит.
  //
  // Збирає не Cloudflare, а GitHub Actions (.github/workflows/deploy.yml):
  // кодування AVIF для ~1800 варіантів не вкладалося в тамтешній ліміт
  // у 30 хвилин, а кеш зображень там не переживав npm ci. Сюди приїжджає
  // вже готовий dist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vm-design",
  "compatibility_date": "2026-09-19",
  "pages_build_output_dir": "./dist"
}
