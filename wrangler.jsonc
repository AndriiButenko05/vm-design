{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vm-design",
  "compatibility_date": "2026-09-19",

  // Сайт живе на домені Марини (акаунт Cloudflare, де куплено домен).
  // www.vmdesignproject.com перенаправляється сюди правилом Redirect Rules у дашборді.
  "routes": [{ "pattern": "vmdesignproject.com", "custom_domain": true }],

  // Без дублів сайту на *.workers.dev і preview-адресах — для Google лише основний домен.
  "workers_dev": false,
  "preview_urls": false,

  // Worker лише для /api/* (відгуки Google); сторінки й файли — статика з dist.
  "main": "./worker/index.js",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],

    "not_found_handling": "404-page"
  },

  // Place ID картки «VM Design Studio». Ключ — секрет GOOGLE_PLACES_KEY у дашборді Cloudflare
  // (Workers → vm-design → Settings → Variables and Secrets), локально — у .dev.vars.
  "vars": {
    "GOOGLE_PLACE_ID": ""
  }
}
